---
// Seed de bola numerada — exibição visual de dezena
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)
---

interface Props {
  value: number;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary';
}

const { value, size = 'md', variant = 'primary' } = Astro.props;

const sizes = {
  sm: { width: '28px', height: '28px', fontSize: '0.85rem' },
  md: { width: '40px', height: '40px', fontSize: '1.1rem' },
  lg: { width: '56px', height: '56px', fontSize: '1.5rem' },
};

const bgColor = variant === 'primary' ? 'var(--color-accent)' : 'var(--color-text-muted)';
const textColor = variant === 'primary' ? '#111' : '#fff';

const style = {
  width: sizes[size].width,
  height: sizes[size].height,
  fontSize: sizes[size].fontSize,
  backgroundColor: bgColor,
  color: textColor,
  borderRadius: '50%',
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'center',
  fontWeight: '600',
  userSelect: 'none',
  flexShrink: '0',
};
---

<span
  style={style}
  aria-label={`Dezena ${value}`}
>
  {value < 10 ? `0${value}` : value}
</span>