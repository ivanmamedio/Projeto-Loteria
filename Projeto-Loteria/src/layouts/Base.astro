---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jogo na Hora — geração gratuita de combinações de loteria com probabilidade verificável" />
    <title>Jogo na Hora — gerador de combinações de loteria</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"></noscript>
    <style>
      :root { --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
    </style>
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo principal</a>

    <header class="header" role="banner">
      <div class="header-inner">
        <a href="/" class="logo" aria-label="Jogo na Hora - Início">
          <span class="logo-mark" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C12 2 9 7 9 10c0 3 3 5 3 5s3-2 3-5c0-3-3-8-3-8z"/>
              <path d="M12 2C12 2 15 7 15 10c0 3-3 5-3 5s-3-2-3-5c0-3 3-8 3-8z"/>
              <path d="M12 2C12 2 7 7 7 10c0 3 5 5 5 5s5-2 5-5c0-3-5-8-5-8z"/>
              <path d="M12 2C12 2 17 7 17 10c0 3-5 5-5 5s-5-2-5-5c0-3 5-8 5-8z"/>
              <path d="M12 10v10"/>
            </svg>
          </span>
          Jogo na Hora
        </a>

        <nav class="nav" aria-label="Navegação principal" id="nav">
          <ul class="nav-list">
            <li><a href="/" class="nav-link">Início</a></li>
            <li><a href="/como-funciona" class="nav-link">Como funciona</a></li>
            <li><a href="/estatisticas" class="nav-link">Estatísticas</a></li>
            <li><a href="/dados" class="nav-link">Dados</a></li>
            <li><a href="/sobre" class="nav-link">Sobre</a></li>
            <li><a href="/privacidade" class="nav-link">Privacidade</a></li>
            <li><a href="/termos" class="nav-link">Termos</a></li>
          </ul>
          <a href="/#contribuicao" class="nav-cta">Contribuir</a>
        </nav>

        <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu" id="nav-toggle">
          <span class="nav-toggle-icon" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="conteudo" role="main">
      <slot />
    </main>

    <div id="responsabilidade-modal" class="modal-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="resp-titulo">
      <div class="modal">
        <div class="modal-header">
          <h2 id="resp-titulo" class="modal-title">Termo de responsabilidade</h2>
        </div>
        <div class="modal-body">
          <p>Este site é independente, gratuito e destinado a pessoas com 18 anos ou mais. As combinações são geradas por algoritmos e não garantem prêmio nem vantagem estatística. Confirme que leu e aceita os termos antes de continuar.</p>
          <label class="form-checkbox" style="margin-top: var(--space-4);">
            <input type="checkbox" id="resp-check" />
            <span>Li e aceito o termo de responsabilidade e os <a href="/termos">Termos de Uso</a>.</span>
          </label>
        </div>
        <div class="modal-footer">
          <a href="/termos" class="btn btn-secondary">Ler termos completos</a>
          <button id="resp-confirm" type="button" class="btn btn-primary" disabled>Aceitar e continuar</button>
        </div>
      </div>
    </div>

    <script>
      const CHAVE_RESP = 'jp-responsabilidade-aceita';
      const modal = document.getElementById('responsabilidade-modal');
      const check = document.getElementById('resp-check');
      const confirmar = document.getElementById('resp-confirm');

      if (modal && !localStorage.getItem(CHAVE_RESP)) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';

        check?.addEventListener('change', () => {
          if (confirmar) confirmar.disabled = !check.checked;
        });

        confirmar?.addEventListener('click', () => {
          localStorage.setItem(CHAVE_RESP, '1');
          modal.hidden = true;
          document.body.style.overflow = '';
        });
      }
    </script>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('nav');

      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(isOpen));
          document.body.style.overflow = isOpen ? 'hidden' : '';
        });

        nav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          });
        });
      }
    </script>

    <script>
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll('.nav-link').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
        if (href === path || (href !== '/' && path.startsWith(href))) {
          a.setAttribute('aria-current', 'page');
        }
      });

      document.querySelectorAll('.sidebar-link').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
        if (href === path || (href !== '/' && path.startsWith(href))) {
          a.setAttribute('aria-current', 'page');
        }
      });
    </script>

    <footer class="footer" role="contentinfo">
      <div class="container">
        <div class="footer-content">
          <p class="footer-text">
            &copy; 2026 — Jogo na Hora. Site independente de estudo e diversão sobre loterias da CAIXA.
            Sem vínculo, afiliação ou endosso da Caixa Econômica Federal.
            Jogo responsável. Público adulto (18+).
            Resultados válidos são sempre os divulgados pela CAIXA.
          </p>
          <ul class="footer-links">
            <li><a href="/privacidade">Privacidade</a></li>
            <li><a href="/termos">Termos</a></li>
            <li><a href="/sobre">Sobre</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>