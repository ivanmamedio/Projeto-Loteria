---
// Página inicial — Gerador de jogos
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)

import Disclaimer from '../components/Disclaimer.astro';
import { modalidadePorId } from '../domain/rules';
import Base from '../layouts/Base.astro';

interface Props {
  modalidadeId?: string;
}

const { modalidadeId } = Astro.props;

let modalidade: ReturnType<typeof modalidadePorId>;
try {
  modalidade = modalidadePorId(modalidadeId ?? 'mega-sena');
} catch (err) {
  modalidade = modalidadePorId('mega-sena');
}
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/>
            <path d="M12 22V12M12 22H2M12 22H22"/>
          </svg>
          Site independente • Gratuito • Sem apostas
        </span>

        <h1 id="hero-title" class="hero-title">
          Sorteie sua <span class="highlight">combinação</span>
        </h1>

        <p class="hero-description">
          Escolha uma modalidade, marque dezenas ou use a seleção automática.
          Toda combinação tem a mesma probabilidade — use estas ferramentas
          para descrever, organizar e diversificar jogos.
        </p>

        <div class="hero-actions">
          <button id="btn-sorteio-hero" type="button" class="btn btn-primary btn-lg" aria-label="Sortear uma combinação rápida">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
            Sortear agora
          </button>
          <a href="/como-funciona" class="btn btn-secondary btn-lg">Como funciona</a>
        </div>

        <nav class="modality-picker" aria-label="Escolha a modalidade">
          <a href="/?modalidade=mega-sena" class="modality-btn" aria-current={modalidade.id === 'mega-sena' ? 'page' : undefined}>
            <span class="modality-btn__label">Mega-Sena</span>
            <span class="modality-btn__meta">6 dezenas · R$ 6,00</span>
          </a>
          <a href="/?modalidade=lotofacil" class="modality-btn" aria-current={modalidade.id === 'lotofacil' ? 'page' : undefined}>
            <span class="modality-btn__label">Lotofácil</span>
            <span class="modality-btn__meta">15 dezenas · R$ 3,50</span>
          </a>
          <a href="/?modalidade=quina" class="modality-btn" aria-current={modalidade.id === 'quina' ? 'page' : undefined}>
            <span class="modality-btn__label">Quina</span>
            <span class="modality-btn__meta">5 dezenas · R$ 3,00</span>
          </a>
          <a href="/?modalidade=lotomania" class="modality-btn" aria-current={modalidade.id === 'lotomania' ? 'page' : undefined}>
            <span class="modality-btn__label">Lotomania</span>
            <span class="modality-btn__meta">50 dezenas fixo · R$ 3,00</span>
          </a>
        </nav>

        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-value" id="stat-concursos">—</div>
            <div class="stat-label">Concursos analisados</div>
          </div>
          <div class="stat-item">
            <div class="stat-value" id="stat-modalidades">4</div>
            <div class="stat-label">Modalidades</div>
          </div>
          <div class="stat-item">
            <div class="stat-value" id="stat-gratuito">100%</div>
            <div class="stat-label">Gratuito</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="benefits-title">
    <div class="container">
      <header style="text-align: center; margin-bottom: var(--space-10);">
        <h2 id="benefits-title" style="margin-bottom: var(--space-3);">Por que usar o Jogo na Hora?</h2>
        <p style="max-width: 580px; margin: 0 auto; color: var(--color-text-muted);">
          Ferramentas transparentes baseadas em dados reais, sem promessas falsas.
        </p>
      </header>

      <div class="grid grid-3">
        <article class="feature-card card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="feature-title">Probabilidade real</h3>
          <p class="feature-description">Toda combinação válida tem exatamente a mesma chance. Nenhum método altera as odds.</p>
        </article>

        <article class="feature-card card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2"/>
              <path d="M8 21h8M12 17v4"/>
            </svg>
          </div>
          <h3 class="feature-title">Histórico local</h3>
          <p class="feature-description">Seus jogos ficam salvos no navegador com cópia, compartilhamento e exportação.</p>
        </article>

        <article class="feature-card card">
          <div class="feature-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <h3 class="feature-title">Fórmulas documentadas</h3>
          <p class="feature-description">F1–F13 calculadas a partir dos dados reais da CAIXA, com metodologia aberta.</p>
        </article>
      </div>
    </div>
  </section>

  <Disclaimer />

  <section class="section" aria-labelledby="generator-title">
    <div class="container">
      <header style="margin-bottom: var(--space-8);">
        <h2 id="generator-title" style="margin-bottom: var(--space-3);">Gerar jogos</h2>
        <p style="max-width: 680px;">
          Escolha uma modalidade, marque dezenas (ou use a seleção automática) e gere combinações.
          Toda combinação tem a mesma probabilidade de sorteio.
        </p>
      </header>

      <div class="controls-panel">
        <h3 class="controls-panel-title">Configurações</h3>

        <div class="controls-grid">
          <div class="form-group">
            <label for="modalidade" class="form-label">Modalidade</label>
            <select id="modalidade" class="form-select">
              <option value="mega-sena">Mega-Sena</option>
              <option value="lotofacil">Lotofácil</option>
              <option value="quina">Quina</option>
              <option value="lotomania">Lotomania</option>
            </select>
          </div>

          <div class="form-group">
            <label for="quantidade" class="form-label">Quantidade (1–10)</label>
            <input id="quantidade" type="number" min="1" max="10" value="3" class="form-input" />
          </div>

          <div class="form-group">
            <label for="estrategia" class="form-label">Estratégia</label>
            <select id="estrategia" class="form-select">
              <option value="E0">E0 — Uniforme</option>
              <option value="E1">E1 — Mais frequentes</option>
              <option value="E2">E2 — Mais atrasadas</option>
              <option value="E3">E3 — Filtros de equilíbrio</option>
              <option value="E4">E4 — Diversificar lote</option>
              <option value="combinado">Combinado (E1+E3+E4)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="janela" class="form-label">Janela de concursos</label>
            <input id="janela" type="number" min="1" value="100" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="filtros" type="checkbox" />
              <span>Filtros de equilíbrio (E3)</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="diversificar" type="checkbox" />
              <span>Diversificar lote (E4)</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="evitaCal" type="checkbox" />
              <span>Evitar padrão de calendário</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="autoSelecionar" type="checkbox" checked />
              <span>Seleção automática de dezenas</span>
            </label>
          </div>
        </div>

        <div class="controls-actions">
          <button id="btn-gerar" type="button" class="btn btn-primary btn-lg" style="flex: 1; min-width: 200px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
            Gerar 3 jogos
          </button>
        </div>
      </div>

      <div class="form-group" style="margin-top: var(--space-6);">
        <label class="form-label">Marcar dezenas manualmente (opcional)</label>
        <div class="grid-actions">
          <button id="btn-limpar-grade" type="button" class="btn btn-secondary btn-sm">Limpar seleção</button>
          <button id="btn-selecionar-todos" type="button" class="btn btn-secondary btn-sm">Marcar todos</button>
          <span id="selecao-info" class="text-muted" style="align-self: center;"></span>
        </div>
        <div id="grade-dezenas" class="number-grid" aria-label="Grade de dezenas" role="group"></div>
      </div>

      <div id="resultado" aria-live="polite" aria-label="Resultados gerados"></div>
      <p id="meta" class="text-muted" style="margin-top: var(--space-4); text-align: center;"></p>

      <section class="history-section" aria-labelledby="historico-titulo">
        <header class="history-header">
          <h3 id="historico-titulo" class="history-title">Histórico local</h3>
          <div class="flex gap-2">
            <button id="btn-compartilhar-selecao" type="button" class="btn btn-secondary btn-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Compartilhar seleção
            </button>
            <button id="btn-limpar-historico" type="button" class="btn btn-secondary btn-sm">Limpar histórico</button>
          </div>
        </header>

        <p class="history-empty" id="historico-vazio">Nenhum jogo salvo ainda.</p>
        <ul id="historico-lista" class="history-list"></ul>
      </section>
    </div>
  </section>

  <section class="section contribution" id="contribuicao" aria-labelledby="contribuicao-title">
    <div class="container">
      <header style="text-align: center; margin-bottom: var(--space-8);">
        <h2 id="contribuicao-title" style="margin-bottom: var(--space-3);">Contribua com nosso site</h2>
        <p style="max-width: 580px; margin: 0 auto;">
          O Jogo na Hora é independente e gratuito. Se o projeto for útil para você,
          considere apoiar a manutenção e a atualização dos dados.
        </p>
      </header>

      <div style="max-width: 480px; margin: 0 auto;">
        <div class="pix-box">
          <span class="pix-label">Chave PIX</span>
          <input type="text" class="pix-key" value="72af7962-0cf1-4f88-8d0f-1c4a58bcde4b" readonly id="pix-key" />
          <button id="btn-copiar-pix" type="button" class="btn btn-secondary btn-sm">Copiar</button>
        </div>
        <p class="text-muted" style="text-align: center; margin-top: var(--space-4);">
          Nenhuma aposta é processada por este site.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { generateGames } from '../domain/generate';
    import { sampleNoReplace } from '../domain/sampling';
    import { modalidadePorId, type ModalidadeId } from '../domain/rules';
    import { loadData } from '../ui/load-data';
    import { addHistory, clearHistory, loadHistory } from '../ui/history';
    import { pad2 } from '../ui/format';

    type GameResult = {
      dezenas: number[];
      meta: { janela: number; taxaAceitacao: number };
    };

    const MODALIDADES_VALIDAS = ['mega-sena', 'lotofacil', 'quina', 'lotomania'] as const;

    const selectMod = document.getElementById('modalidade') as HTMLSelectElement;
    const params = new URLSearchParams(window.location.search);
    const inicial = params.get('modalidade');
    if (inicial && (MODALIDADES_VALIDAS as readonly string[]).includes(inicial)) {
      selectMod.value = inicial;
    }

    const qInput = document.getElementById('quantidade') as HTMLInputElement;
    const estrategia = document.getElementById('estrategia') as HTMLSelectElement;
    const filtros = document.getElementById('filtros') as HTMLInputElement;
    const diversificar = document.getElementById('diversificar') as HTMLInputElement;
    const evitaCal = document.getElementById('evitaCal') as HTMLInputElement;
    const janela = document.getElementById('janela') as HTMLInputElement;
    const autoSelecionar = document.getElementById('autoSelecionar') as HTMLInputElement;
    const btn = document.getElementById('btn-gerar') as HTMLButtonElement;
    const out = document.getElementById('resultado') as HTMLElement;
    const outHero = document.getElementById('resultado-hero') as HTMLElement | null;
    const meta = document.getElementById('meta') as HTMLElement;
    const grade = document.getElementById('grade-dezenas') as HTMLElement;
    const selecaoInfo = document.getElementById('selecao-info') as HTMLElement;
    const btnLimparGrade = document.getElementById('btn-limpar-grade') as HTMLButtonElement;
    const btnSelecionarTodos = document.getElementById('btn-selecionar-todos') as HTMLButtonElement;
    const historicoLista = document.getElementById('historico-lista') as HTMLElement;
    const historicoVazio = document.getElementById('historico-vazio') as HTMLElement;
    const btnLimparHistorico = document.getElementById('btn-limpar-historico') as HTMLButtonElement;
    const btnCompartilharSelecao = document.getElementById('btn-compartilhar-selecao') as HTMLButtonElement | null;
    const btnCopiarPix = document.getElementById('btn-copiar-pix') as HTMLButtonElement | null;
    const btnSorteioHero = document.getElementById('btn-sorteio-hero') as HTMLButtonElement | null;

    const selecionadas = new Set<number>();
    let ultimosJogos: number[][] = [];
    let moverParaHero = false;

    function dezenasUniverso(mod: string): number[] {
      const m = modalidadePorId(mod as ModalidadeId);
      const total = m.universo + (mod === 'lotomania' ? 1 : 0);
      const min = mod === 'lotomania' ? 0 : 1;
      return Array.from({ length: total }, (_, i) => min + i);
    }

    function atualizarSelecaoInfo(): void {
      selecaoInfo.textContent = `${selecionadas.size} dezena(s) selecionada(s)`;
    }

    function renderizarGrade(): void {
      const mod = selectMod.value;
      const dezenas = dezenasUniverso(mod);
      grade.innerHTML = '';
      selecionadas.clear();

      const isLotomania = mod === 'lotomania';

      for (const d of dezenas) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `number-btn${isLotomania ? ' number-btn--lotomania' : ''}`;
        b.textContent = isLotomania ? pad2(d) : pad2(d);
        b.dataset.value = String(d);
        b.setAttribute('aria-label', `Dezena ${pad2(d)}`);
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          if (selecionadas.has(d)) {
            selecionadas.delete(d);
            b.classList.remove('selected');
            b.setAttribute('aria-pressed', 'false');
          } else {
            selecionadas.add(d);
            b.classList.add('selected');
            b.setAttribute('aria-pressed', 'true');
          }
          atualizarSelecaoInfo();
        });
        grade.appendChild(b);
      }
      atualizarSelecaoInfo();
    }

    function atualizarBotao(): void {
      const q = Math.max(1, Math.min(10, Number(qInput.value) || 3));
      btn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
        Gerar ${q} jogo${q > 1 ? 's' : ''}
      `;
    }

    async function concursosDaModalidade(mod: string): Promise<number[][]> {
      const res = await loadData<{ concursos: { dezenas: number[] }[] }>(`/data/${mod}.json`);
      if (!res.ok || !res.data) return [];
      return (res.data.concursos || []).map((c) => c.dezenas);
    }

    function renderizarHistorico(): void {
      const entries = loadHistory();
      historicoLista.innerHTML = '';
      if (entries.length === 0) {
        historicoVazio.style.display = '';
        return;
      }
      historicoVazio.style.display = 'none';
      for (const e of entries) {
        const li = document.createElement('li');
        li.className = 'history-item';
        const nums = document.createElement('span');
        nums.className = 'history-numbers';
        nums.textContent = e.dezenas.map((d) => pad2(d)).join(' ');
        const metaSpan = document.createElement('span');
        metaSpan.className = 'history-meta';
        metaSpan.textContent = `${e.modalidade} · ${new Date(e.timestamp).toLocaleString('pt-BR')}`;
        li.appendChild(nums);
        li.appendChild(metaSpan);
        historicoLista.appendChild(li);
      }
    }

    function copiarTexto(texto: string): void {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(texto).catch(() => {});
      }
    }

    function baixarBlob(blob: Blob, nome: string): void {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = nome;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    async function gerarImagemJogo(dezenas: number[], modalidade: string): Promise<Blob | null> {
      const canvas = document.createElement('canvas');
      canvas.width = 900;
      canvas.height = 360;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      ctx.fillStyle = '#fafafa';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#171717';
      ctx.font = 'bold 40px Inter, system-ui, sans-serif';
      ctx.fillText('Jogo na Hora', 40, 60);

      ctx.fillStyle = '#525252';
      ctx.font = '22px Inter, system-ui, sans-serif';
      ctx.fillText(`Modalidade: ${modalidade}`, 40, 95);

      const balls = dezenas.map((d) => d.toString().padStart(2, '0'));
      let x = 40;
      const y = 185;
      for (const ball of balls) {
        ctx.beginPath();
        ctx.arc(x + 32, y, 32, 0, Math.PI * 2);
        ctx.fillStyle = '#2f7a12';
        ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 20px Inter, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(ball, x + 32, y);
        ctx.textAlign = 'start';
        ctx.textBaseline = 'alphabetic';
        x += 76;
        if (x > canvas.width - 80) {
          x = 40;
        }
      }

      ctx.fillStyle = '#525252';
      ctx.font = '14px Inter, system-ui, sans-serif';
      ctx.fillText('Aviso: toda combinação tem a mesma probabilidade de sorteio.', 40, 320);
      ctx.fillText('Site independente. Resultados válidos são os divulgados pela CAIXA.', 40, 342);

      return await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.95));
    }

    async function gerarImagemJogos(jogos: number[][], modalidade: string): Promise<Blob | null> {
      const canvas = document.createElement('canvas');
      canvas.width = 900;
      canvas.height = Math.max(360, 120 + jogos.length * 56 + 80);
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      ctx.fillStyle = '#fafafa';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = '#171717';
      ctx.font = 'bold 40px Inter, system-ui, sans-serif';
      ctx.fillText('Jogo na Hora', 40, 60);

      ctx.fillStyle = '#525252';
      ctx.font = '22px Inter, system-ui, sans-serif';
      ctx.fillText(`Modalidade: ${modalidade}`, 40, 95);

      let y = 150;
      for (const dezenas of jogos) {
        const texto = dezenas.map((d) => d.toString().padStart(2, '0')).join('  ');
        ctx.fillStyle = '#171717';
        ctx.font = 'bold 24px Inter, system-ui, sans-serif';
        ctx.fillText(texto, 40, y);
        y += 46;
      }

      ctx.fillStyle = '#525252';
      ctx.font = '14px Inter, system-ui, sans-serif';
      ctx.fillText('Aviso: toda combinação tem a mesma probabilidade de sorteio.', 40, canvas.height - 42);
      ctx.fillText('Site independente. Resultados válidos são os divulgados pela CAIXA.', 40, canvas.height - 20);

      return await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.95));
    }

    function criarGameCard(texto: string, modalidade: string): HTMLElement {
      const card = document.createElement('div');
      card.className = 'game-card';
      card.innerHTML = `
        <div class="game-header">
          <span class="game-title">${modalidade}</span>
          <span class="game-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            </svg>
            Jogo gerado
          </span>
        </div>
        <div class="game-numbers">${texto.split(' - ').map(n => `<span class="result-ball">${n}</span>`).join('')}</div>
        <div class="game-actions">
          <button type="button" class="btn btn-secondary btn-sm" data-action="copy">Copiar</button>
          <button type="button" class="btn btn-secondary btn-sm" data-action="download">Baixar imagem</button>
          <button type="button" class="btn btn-secondary btn-sm" data-action="share">WhatsApp</button>
          <button type="button" class="btn btn-secondary btn-sm" data-action="txt">Arquivo .txt</button>
        </div>
      `;
      return card;
    }

    btnLimparGrade.addEventListener('click', () => {
      selecionadas.clear();
      grade.querySelectorAll('.number-btn').forEach((el) => {
        el.classList.remove('selected');
        el.setAttribute('aria-pressed', 'false');
      });
      atualizarSelecaoInfo();
    });

    btnSelecionarTodos.addEventListener('click', () => {
      dezenasUniverso(selectMod.value).forEach((d) => selecionadas.add(d));
      grade.querySelectorAll('.number-btn').forEach((el) => {
        el.classList.add('selected');
        el.setAttribute('aria-pressed', 'true');
      });
      atualizarSelecaoInfo();
    });

    btnCompartilharSelecao?.addEventListener('click', () => {
      const nums = Array.from(selecionadas)
        .sort((a, b) => a - b)
        .map((d) => pad2(d))
        .join(' - ');
      const texto = `Jogo na Hora — ${selectMod.value}: ${nums || 'nenhuma dezena selecionada'}`;
      window.open(`https://wa.me/?text=${encodeURIComponent(texto)}`, '_blank', 'noopener,noreferrer');
    });

    btnLimparHistorico.addEventListener('click', () => {
      clearHistory();
      renderizarHistorico();
    });

    selectMod.addEventListener('change', () => {
      renderizarGrade();
    });

    qInput.addEventListener('input', atualizarBotao);

    btn.addEventListener('click', async () => {
      const modalidade = selectMod.value;
      const m = modalidadePorId(modalidade as ModalidadeId);
      const q = Math.max(1, Math.min(10, Number(qInput.value) || 3));
      const dezenas = dezenasUniverso(modalidade);

      let marcadas: number[] = Array.from(selecionadas);
      if (autoSelecionar.checked || marcadas.length < m.minDezenas) {
        const faltam = Math.max(m.minDezenas, m.dezenasSorteadas + 6) - marcadas.length;
        if (faltam > 0) {
          const pool = dezenas.filter((d) => !marcadas.includes(d));
          const extras = sampleNoReplace(pool.length, Math.min(pool.length, faltam), Math.random).map(
            (idx) => pool[idx] as number,
          );
          marcadas = marcadas.concat(extras);
        }
      }

      const opcoes: Record<string, unknown> = {
        janela: Math.max(1, Number(janela.value) || 100),
      };
      const est = estrategia.value;
      if (est === 'combinado') opcoes.estrategia = ['E1', 'E3', 'E4'];
      else opcoes.estrategia = est;
      if (filtros.checked) opcoes.filtros = true;
      if (diversificar.checked) opcoes.diversificar = true;
      if (evitaCal.checked) opcoes.evitaCalendario = true;

      btn.disabled = true;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="animation: spin 1s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1" stroke-linecap="round"/>
        </svg>
        Gerando…
      `;
      try {
        const concursos = await concursosDaModalidade(modalidade);
        if (concursos.length > 0) opcoes.concursos = concursos;
        const resultado = generateGames(
          { modalidade: modalidade as ModalidadeId, dezenasMarcadas: marcadas, opcoes },
          q,
        ) as unknown as { games: GameResult[]; meta: { janela: number; taxaAceitacao: number } };
        const lista = Array.isArray(resultado.games) ? resultado.games : [resultado as unknown as GameResult];
        out.innerHTML = '';
        ultimosJogos = lista.map((g: GameResult) => g.dezenas);

        for (const g of lista) {
          const texto = g.dezenas.map((d: number) => pad2(d)).join(' - ');
          const card = criarGameCard(texto, modalidade);
          out.appendChild(card);

          // Bind actions
          card.querySelector('[data-action="copy"]')?.addEventListener('click', () => copiarTexto(texto));
          card.querySelector('[data-action="download"]')?.addEventListener('click', async () => {
            const blob = await gerarImagemJogos(ultimosJogos, modalidade);
            if (blob) baixarBlob(blob, `jogo-na-hora-${modalidade}-${Date.now()}.jpg`);
          });
          card.querySelector('[data-action="share"]')?.addEventListener('click', async () => {
            const textoCompartilhamento = `Jogo na Hora — ${modalidade}:\n${ultimosJogos.map(j => j.map(d => pad2(d)).join(' - ')).join('\n')}`;
            const blob = await gerarImagemJogos(ultimosJogos, modalidade);
            if (blob && navigator.share && navigator.canShare) {
              const arquivo = new File([blob], 'jogo-na-hora.jpg', { type: 'image/jpeg' });
              if (navigator.canShare({ files: [arquivo] })) {
                try {
                  await navigator.share({ title: 'Jogo na Hora', text: textoCompartilhamento, files: [arquivo] });
                  return;
                } catch {
                  // fallback
                }
              }
            }
            window.open(`https://wa.me/?text=${encodeURIComponent(textoCompartilhamento)}`, '_blank', 'noopener,noreferrer');
          });
          card.querySelector('[data-action="txt"]')?.addEventListener('click', () => {
            const conteudo = `Jogo na Hora\nModalidade: ${modalidade}\nDezenas:\n${ultimosJogos.map(j => j.map(d => pad2(d)).join(' - ')).join('\n')}\n\nAviso: toda combinação tem a mesma probabilidade de sorteio.`;
            const blob = new Blob([conteudo], { type: 'text/plain;charset=utf-8' });
            baixarBlob(blob, `jogo-na-hora-${modalidade}-${Date.now()}.txt`);
          });
        }

        meta.textContent = `Janela: ${resultado.meta.janela} concursos · Taxa de aceitação: ${(resultado.meta.taxaAceitacao * 100).toFixed(1)}%`;

        const timestamp = new Date().toISOString();
        for (const g of lista) {
          addHistory({
            id: `${modalidade}-${timestamp}-${g.dezenas.join(',')}`,
            modalidade,
            dezenas: g.dezenas,
            timestamp,
          });
        }
        renderizarHistorico();

        // Scroll para resultado
        out.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        out.innerHTML = `<div class="alert alert-error" role="alert"><div class="alert-content"><p class="alert-message">${(err as Error).message}</p></div></div>`;
        meta.textContent = '';
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHTML;
        atualizarBotao();
      }
    });

    btnCopiarPix?.addEventListener('click', () => {
      copiarTexto('72af7962-0cf1-4f88-8d0f-1c4a58bcde4b');
      btnCopiarPix.textContent = 'Copiado!';
      setTimeout(() => { if (btnCopiarPix) btnCopiarPix.textContent = 'Copiar'; }, 2000);
    });

    btnSorteioHero?.addEventListener('click', () => {
      qInput.value = '1';
      atualizarBotao();
      moverParaHero = true;
      btn.click();
    });

    // Observer para mover resultado pro hero se clicou no hero
    const obsResultado = new MutationObserver(() => {
      if (moverParaHero && out.children.length > 0 && outHero) {
        while (out.firstChild) outHero.appendChild(out.firstChild);
        out.innerHTML = '';
        moverParaHero = false;
        outHero.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    obsResultado.observe(out, { childList: true });

    // Carregar contagem de concursos para hero stats
    async function carregarStatsHero() {
      try {
        let total = 0;
        for (const mod of MODALIDADES_VALIDAS) {
          const res = await loadData<{ concursos: { dezenas: number[] }[] }>(`/data/${mod}.json`);
          if (res.ok && res.data?.concursos) total += res.data.concursos.length;
        }
        const el = document.getElementById('stat-concursos');
        if (el) el.textContent = total.toLocaleString('pt-BR');
      } catch {}
    }
    carregarStatsHero();

    renderizarGrade();
    atualizarBotao();
    renderizarHistorico();

    // Estilo para spinner
    const style = document.createElement('style');
    style.textContent = `@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }`;
    document.head.appendChild(style);
  </script>
</Base>