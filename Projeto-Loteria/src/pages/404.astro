---
// Página 404 — não encontrado
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)

import Base from '../layouts/Base.astro';
---

<Base>
  <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="container">
      <div class="card" style="max-width: 400px; margin: 0 auto;">
        <div class="card-body" style="padding: var(--space-12) var(--space-8);">
          <h1 style="font-size: var(--text-5xl); font-weight: var(--font-bold); color: var(--color-accent); margin: 0 0 var(--space-4); line-height: 1;">404</h1>
          <h2 style="margin: 0 0 var(--space-4);">Página não encontrada</h2>
          <p style="margin: 0 0 var(--space-8); color: var(--color-text-muted);">
            A página que você procura não existe ou foi movida.
          </p>
          <a href="/" class="btn btn-primary btn-block">Voltar para a página inicial</a>
        </div>
      </div>
    </div>
  </section>
</Base>