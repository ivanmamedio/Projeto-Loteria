---
import Disclaimer from '../components/Disclaimer.astro';
// Página de termos de uso
// Referência: tasks_loteria.md — Review jurídica (T6.5)

import Base from '../layouts/Base.astro';
---

<Base>
  <header class="page-header" aria-labelledby="page-title">
    <div class="container">
      <h1 id="page-title" class="page-title">Termos de Uso</h1>
      <p class="page-description">
        Ao utilizar este site, você concorda com as condições abaixo.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">1. Finalidade</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            O site tem caráter educativo e de estudo sobre a loteria da CAIXA. O
            conteúdo não constitui orientação financeira, de investimento ou de
            apostas.
          </p>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">2. Uso permitido</h2>
        </div>
        <div class="card-body">
          <ul style="margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-3);">
            <li>Uso pessoal e educacional.</li>
            <li>Uso acadêmico e de pesquisa.</li>
          </ul>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">3. Uso proibido</h2>
        </div>
        <div class="card-body">
          <ul style="margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-3);">
            <li>Representar que o site é oficial da CAIXA.</li>
            <li>Prometer ganho ou vantagem estatística.</li>
            <li>Usar o conteúdo para fins comerciais sem autorização.</li>
            <li>Postar conteúdo que sugira vantagem ou garantia de prêmio.</li>
          </ul>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">4. Dados e privacidade</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            Consulte a <a href="/privacidade">Política de Privacidade</a> para
            detalhes.
          </p>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">5. Responsabilidade</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            O site é disponibilizado "como está". O autor não se responsabiliza por
            decisões baseadas nas informações fornecidas.
          </p>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">6. Limitações e aviso de IA/algoritmos</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            As combinações são geradas por algoritmos determinísticos. Os resultados
            podem conter imperfeições e não garantem prêmio ou vantagem.
          </p>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-6);">
        <div class="card-header">
          <h2 class="card-title">7. Vínculo com a CAIXA</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            Este site é independente e não é afiliado, endossado ou patrocinado pela
            Caixa Econômica Federal. Os nomes das loterias são usados apenas para
            identificação factual.
          </p>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">8. Alterações</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            Estes termos podem ser atualizados. A versão vigente está disponível no site.
            O uso contínuo após alterações constitui aceitação.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Disclaimer />
</Base>