---
import Disclaimer from '../components/Disclaimer.astro';
// Página "Sobre" — quem somos, propósito do projeto
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)

import Base from '../layouts/Base.astro';
---

<Base>
  <header class="page-header" aria-labelledby="page-title">
    <div class="container">
      <h1 id="page-title" class="page-title">Sobre o Jogo na Hora</h1>
      <p class="page-description">
        Site independente de estudo e diversão sobre as loterias da CAIXA.
        Projetado com transparência — fórmulas, dados e probabilidades
        expostos para quem quer entender, não para quem quer ganhar.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container" style="max-width: 720px;">
      <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card-header">
          <h2 class="card-title">Objetivo</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0; font-size: var(--text-lg);">
            Fornecer uma ferramenta gratuita e acessível para consulta de dados
            históricos, geração de jogos e estudo de probabilidades. Sem anúncios,
            sem levantamento de dados de jogadores — apenas informação.
          </p>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card-header">
          <h2 class="card-title">Princípios</h2>
        </div>
        <div class="card-body">
          <ul style="margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-4);">
            <li>
              <strong>Uniformidade:</strong> toda combinação tem a mesma probabilidade.
            </li>
            <li>
              <strong>Transparência:</strong> fórmulas documentadas e calculadas a partir dos dados reais.
            </li>
            <li>
              <strong>Verdade:</strong> nenhum texto sugere previsão ou vantagem estatística.
            </li>
            <li>
              <strong>Respeito:</strong> sem indicação de vínculo com a CAIXA.
            </li>
            <li>
              <strong>Idade:</strong> conteúdo destinado a pessoas com 18 anos ou mais.
            </li>
          </ul>
        </div>
      </div>

      <div class="card" style="margin-bottom: var(--space-8);">
        <div class="card-header">
          <h2 class="card-title">Fontes e licença</h2>
        </div>
        <div class="card-body">
          <p style="margin: 0;">
            Os resultados históricos são derivados de dados públicos da CAIXA e da
            compilação LotoAgora. O site não se apresenta como publicação oficial.
          </p>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Tecnologia</h2>
        </div>
        <div class="card-body">
          <ul style="margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-3);">
            <li><strong>Framework:</strong> Astro 4 + TypeScript</li>
            <li><strong>Estilo:</strong> CSS puro (design system customizado)</li>
            <li><strong>Testes:</strong> Vitest (unit) + Playwright (e2e)</li>
            <li><strong>Lint/Format:</strong> Biome</li>
            <li><strong>Deploy:</strong> Vercel / Netlify / Static hosting</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Disclaimer />
</Base>