---
import Disclaimer from '../components/Disclaimer.astro';
// Página "Dados" — origem e atualização dos dados
// Referência: tasks_loteria.md — T0.1, T0.2

import Base from '../layouts/Base.astro';
---

<Base>
  <header class="page-header" aria-labelledby="page-title">
    <div class="container">
      <h1 id="page-title" class="page-title">Dados</h1>
      <p class="page-description">
        Dados históricos das 4 modalidades da CAIXA. Fonte oficial e licença documentadas.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-4" style="margin-bottom: var(--space-8);">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Mega-Sena</h3>
          </div>
          <div class="card-body">
            <p style="font-size: var(--text-xl); font-weight: var(--font-semibold); margin: 0;">3.073</p>
            <p style="margin-top: var(--space-1); color: var(--color-text-muted);">Concursos</p>
            <p style="margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-subtle);">1996 — 2026</p>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Lotofácil</h3>
          </div>
          <div class="card-body">
            <p style="font-size: var(--text-xl); font-weight: var(--font-semibold); margin: 0;">3.811</p>
            <p style="margin-top: var(--space-1); color: var(--color-text-muted);">Concursos</p>
            <p style="margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-subtle);">2003 — 2026</p>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Quina</h3>
          </div>
          <div class="card-body">
            <p style="font-size: var(--text-xl); font-weight: var(--font-semibold); margin: 0;">7.149</p>
            <p style="margin-top: var(--space-1); color: var(--color-text-muted);">Concursos</p>
            <p style="margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-subtle);">1994 — 2026</p>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Lotomania</h3>
          </div>
          <div class="card-body">
            <p style="font-size: var(--text-xl); font-weight: var(--font-semibold); margin: 0;">2.990</p>
            <p style="margin-top: var(--space-1); color: var(--color-text-muted);">Concursos</p>
            <p style="margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-subtle);">1999 — 2026</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Fonte e licença</h3>
        </div>
        <div class="card-body">
          <p style="margin-bottom: var(--space-4);">
            Dados provenientes de <strong>LotoAgora</strong> (derivado da API oficial da CAIXA).
            Licença permite uso para análise e publicação com identificação da fonte.
          </p>
          <p style="margin: 0;">
            <strong>Atualização manual:</strong> baixar CSV →
            <code>npm run data:import</code> → revisar diff → commit.
          </p>
        </div>
      </div>

      <div class="card" style="margin-top: var(--space-6);">
        <div class="card-header">
          <h3 class="card-title">Arquivos disponíveis</h3>
        </div>
        <div class="card-body">
          <ul style="margin: 0; padding-left: var(--space-6); display: grid; gap: var(--space-2);">
            <li><code>/data/mega-sena.json</code> — Concursos da Mega-Sena</li>
            <li><code>/data/lotofacil.json</code> — Concursos da Lotofácil</li>
            <li><code>/data/quina.json</code> — Concursos da Quina</li>
            <li><code>/data/lotomania.json</code> — Concursos da Lotomania</li>
          </ul>
          <p style="margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted);">
            Formato: JSON com array <code>concursos</code> contendo objetos com <code>dezenas: number[]</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Disclaimer />
</Base>