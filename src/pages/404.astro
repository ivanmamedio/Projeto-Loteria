---
// Página 404 — não encontrado
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)

import Base from '../layouts/Base.astro';
const base = `${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/`;
---

<Base modalidade="mega-sena">
  <section class="page-header section-highlight accent">
    <div class="container">
      <div class="blob-top-left"></div>
      <h1 class="display-heading">404</h1>
      <p>Página não encontrada.</p>
      <a href={base} class="btn btn-primary btn-lg">Voltar para a página inicial</a>
    </div>
  </section>
</Base>
