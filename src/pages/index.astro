---
// Página inicial — Gerador de jogos
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)

import Disclaimer from '../components/Disclaimer.astro';
import { modalidadePorId } from '../domain/rules';
import Base from '../layouts/Base.astro';

interface Props {
  modalidadeId?: string;
}

const { modalidadeId } = Astro.props;

let modalidade: ReturnType<typeof modalidadePorId>;
try {
  modalidade = modalidadePorId(modalidadeId ?? 'mega-sena');
} catch (err) {
  modalidade = modalidadePorId('mega-sena');
}
const base = `${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/`;
---

<Base modalidade={modalidade}>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Site independente · Gratuito · Sem apostas · Dados oficiais CAIXA
        </span>

        <h1 id="hero-title" class="hero-title">
          Gere jogos com <span class="highlight">metodologia transparente</span>
        </h1>

        <p class="hero-description">
          Escolha a modalidade, configure a estratégia e gere combinações.
          Toda combinação tem a mesma probabilidade — use nossas ferramentas
          para descrever, organizar e diversificar seus jogos com base em dados reais.
        </p>

        <div class="hero-actions">
          <button id="btn-sorteio-hero" type="button" class="btn btn-primary btn-lg" aria-label="Gerar uma combinação rápida da Mega-Sena">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
            Gerar meu primeiro jogo
          </button>
          <a href={`${base}como-funciona`} class="btn btn-secondary btn-lg">Como funciona</a>
        </div>

        <!-- Trust bar -->
        <div class="hero-trust" aria-label="Indicadores de confiança">
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Dados oficiais Caixa</span>
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
            <span>Histórico local no navegador</span>
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>Fórmulas abertas (F1–F13)</span>
          </div>
          <div class="hero-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
            <span>100% gratuito • Sem cadastro</span>
          </div>
        </div>

        <!-- Modalidade picker -->
        <nav class="modality-picker" aria-label="Escolha a modalidade" role="group">
          <button type="button" class="modality-card" data-modalidade="mega-sena" aria-pressed="true">
            <span class="modality-card__label">Mega-Sena</span>
            <span class="modality-card__meta">6 dezenas · R$ 6,00</span>
          </button>
          <button type="button" class="modality-card" data-modalidade="lotofacil" aria-pressed="false">
            <span class="modality-card__label">Lotofácil</span>
            <span class="modality-card__meta">15 dezenas · R$ 3,50</span>
          </button>
          <button type="button" class="modality-card" data-modalidade="quina" aria-pressed="false">
            <span class="modality-card__label">Quina</span>
            <span class="modality-card__meta">5 dezenas · R$ 3,00</span>
          </button>
          <button type="button" class="modality-card" data-modalidade="lotomania" aria-pressed="false">
            <span class="modality-card__label">Lotomania</span>
            <span class="modality-card__meta">50 dezenas fixo · R$ 3,00</span>
          </button>
        </nav>

        <!-- Modalidades disponíveis no gerador principal abaixo -->

        <!-- Resultado do "Gerar meu primeiro jogo" -->
        <div id="hero-result" class="hero-result" aria-live="polite"></div>

        <!-- Hero stats -->
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-value" id="stat-concursos">Carregando…</div>
            <div class="stat-label">Concursos analisados</div>
          </div>
          <div class="stat-item">
            <div class="stat-value">4</div>
            <div class="stat-label">Modalidades</div>
          </div>
          <div class="stat-item">
            <div class="stat-value" id="stat-atualizado">Atualizado após cada sorteio</div>
            <div class="stat-label">Dados</div>
          </div>
          <div class="stat-item">
            <div class="stat-value" id="stat-responsavel">18+</div>
            <div class="stat-label">Jogo responsável</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GENERATOR SECTION -->
  <section class="section" aria-labelledby="generator-title" style="background: var(--color-bg);">
    <div class="container">
      <header class="section-header">
        <h2 id="generator-title">Gerador avançado de jogos</h2>
        <p>Configure sua modalidade, escolha a estratégia e gere combinações organizadas. Histórico salvo automaticamente.</p>
      </header>

      <div class="controls-panel">
        <h3 class="controls-panel-title">Configurações</h3>

        <div class="controls-grid">
          <div class="form-group">
            <label for="modalidade" class="form-label">Modalidade</label>
            <select id="modalidade" class="form-select">
              <option value="mega-sena">Mega-Sena</option>
              <option value="lotofacil">Lotofácil</option>
              <option value="quina">Quina</option>
              <option value="lotomania">Lotomania</option>
            </select>
          </div>

          <div class="form-group">
            <label for="quantidade" class="form-label">Quantidade (1–10)</label>
            <input id="quantidade" type="number" min="1" max="10" value="3" class="form-input" />
          </div>

          <div class="form-group">
            <label for="estrategia" class="form-label">Estratégia</label>
            <select id="estrategia" class="form-select">
              <option value="E0">E0 — Uniforme (aleatório puro)</option>
              <option value="E1">E1 — Mais frequentes</option>
              <option value="E2">E2 — Mais atrasadas</option>
              <option value="E3">E3 — Filtros de equilíbrio</option>
              <option value="E4">E4 — Diversificar lote</option>
              <option value="combinado">Combinado (E1+E3+E4)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="janela" class="form-label">Janela de concursos (análise)</label>
            <input id="janela" type="number" min="1" value="100" class="form-input" />
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="filtros" type="checkbox" />
              <span>Filtros de equilíbrio (E3) — pares/ímpares, soma, faixas</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="diversificar" type="checkbox" />
              <span>Diversificar lote (E4) — evita jogos parecidos</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="evitaCal" type="checkbox" />
              <span>Evitar padrão de calendário (dias 1–31)</span>
            </label>
          </div>

          <div class="form-group">
            <label class="form-checkbox">
              <input id="autoSelecionar" type="checkbox" checked />
              <span>Seleção automática de dezenas (completa o mínimo)</span>
            </label>
          </div>
        </div>

        <div class="controls-actions">
          <button id="btn-gerar" type="button" class="btn btn-primary btn-lg" style="flex: 1; min-width: 200px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
            Gerar 3 jogos
          </button>
        </div>
      </div>

      <!-- Resultado do gerador avançado (abaixo dos controles) -->
      <div id="resultado-avancado" class="resultado-avancado" aria-live="polite" aria-label="Resultados gerados"></div>

      <div class="form-group" style="margin-top: var(--space-6);">
        <label class="form-label">Marcar dezenas manualmente (opcional)</label>
        <div class="grid-actions">
          <button id="btn-limpar-grade" type="button" class="btn btn-secondary btn-sm">Limpar seleção</button>
          <button id="btn-selecionar-todos" type="button" class="btn btn-secondary btn-sm">Marcar todos</button>
          <span id="selecao-info" class="text-muted" style="align-self: center;"></span>
        </div>
        <div id="grade-dezenas" class="number-grid" aria-label="Grade de dezenas" role="group"></div>
      </div>

      <div id="resultado" aria-live="polite" aria-label="Resultados gerados"></div>
      <p id="meta" class="text-muted" style="margin-top: var(--space-4); text-align: center;"></p>

      <section class="history-section" aria-labelledby="historico-titulo">
        <header class="history-header">
          <h3 id="historico-titulo" class="history-title">Histórico local</h3>
          <div class="flex gap-2">
            <button id="btn-compartilhar-selecao" type="button" class="btn btn-secondary btn-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Compartilhar seleção
            </button>
            <button id="btn-limpar-historico" type="button" class="btn btn-secondary btn-sm">Limpar histórico</button>
          </div>
        </header>

        <p class="history-empty" id="historico-vazio">Nenhum jogo salvo ainda. Gere seu primeiro jogo acima.</p>
        <ul id="historico-lista" class="history-list"></ul>
      </section>

  <!-- PROCESS STEPS (AGR-style: Discover → Design → Build → Launch adapted) -->
  <section class="section" aria-labelledby="process-title" style="background: var(--color-bg);">
    <div class="container">
      <header class="section-header">
        <h2 id="process-title">Como funciona em 4 passos</h2>
        <p>Simples, transparente, sem cadastro. Do zero ao jogo em segundos.</p>
      </header>

      <ol class="process-steps">
        <li class="process-step">
          <div class="step-content">
            <h3>Escolha a modalidade</h3>
            <p>Mega-Sena, Lotofácil, Quina ou Lotomania. Cada uma com suas regras, probabilidades e preço.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-content">
            <h3>Configure a estratégia</h3>
            <p>Selecione quantidade (1–10), estratégia (E0–E4), filtros de equilíbrio, janela de análise.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-content">
            <h3>Gere as combinações</h3>
            <p>Resultados com dezenas legíveis, resumo do método usado, taxa de aceitação dos filtros.</p>
          </div>
        </li>
        <li class="process-step">
          <div class="step-content">
            <h3>Entenda e use com responsabilidade</h3>
            <p>Copie, compartilhe, salve no histórico. Lembre-se: toda combinação tem a mesma probabilidade.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- TRUST GRID (Sinais de confiança) -->
  <section class="section section-trust" aria-labelledby="trust-title" style="background: var(--color-bg);">
    <div class="container">
      <header class="section-header">
        <h2 id="trust-title">Transparência e confiança</h2>
        <p>Não prometemos ganhos. Prometemos clareza.</p>
      </header>

      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>Dados Oficiais CAIXA</h3>
          <p>Resultados importados diretamente das fontes oficiais, com data de atualização visível em cada página.</p>
        </div>

        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Metodologia Aberta</h3>
          <p>Todas as fórmulas (F1–F13), estratégias (E0–E4) e filtros documentados com limitações claras.</p>
        </div>

        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <h3>Privacidade Real</h3>
          <p>Zero coleta de dados pessoais. Histórico fica só no seu navegador. Sem cookies de rastreamento.</p>
        </div>

        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>Performance</h3>
          <p>Astro + CSS puro = carregamento instantâneo. Core Web Vitals otimizados. PWA planejado para próxima versão.</p>
        </div>

        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </div>
          <h3>Código Aberto</h3>
          <p>Lógica de geração e regras auditáveis no GitHub. Qualquer um pode verificar a implementação.</p>
        </div>

        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h3>Atualizações Regulares</h3>
          <p>Dados atualizados após cada sorteio. Veja a <a href={`${base}dados`} style="color: var(--color-primary); font-weight: 600;">página de dados</a> para detalhes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- METHOD CARDS (Metodologias E0–E4 — estilo Case Studies) -->
  <section class="section" aria-labelledby="methods-title">
    <div class="container">
      <header class="section-header">
        <h2 id="methods-title">Estratégias de geração (E0–E4)</h2>
        <p>Cada estratégia serve a um propósito descritivo/organizacional — nenhuma aumenta a chance de ganhar.</p>
      </header>

      <div class="grid grid-3">
        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">E0</span>
            <h3>Uniforme (Padrão)</h3>
          </header>
          <p class="method-description">Seleção completamente aleatória, cada dezena tem a mesma probabilidade. Base para comparação.</p>
          <ul class="method-details">
            <li>Uso: Referência, baseline</li>
            <li>Viés: Nenhum</li>
            <li>Indicado: Qualquer situação</li>
          </ul>
          <a href={`${base}metodologia#e0`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">E1</span>
            <h3>Mais Frequentes</h3>
          </header>
          <p class="method-description">Prioriza dezenas que mais saíram na janela selecionada. Descritivo — não preditivo.</p>
          <ul class="method-details">
            <li>Uso: Ver dezenas "quentes" históricas</li>
            <li>Viés: Frequência passada</li>
            <li>Limitação: Não prevê futuros sorteios</li>
          </ul>
          <a href={`${base}metodologia#e1`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">E2</span>
            <h3>Mais Atrasadas</h3>
          </header>
          <p class="method-description">Prioriza dezenas que não saem há mais tempo. Baseada no conceito descritivo de "atraso".</p>
          <ul class="method-details">
            <li>Uso: Ver dezenas "frias" históricas</li>
            <li>Viés: Atraso passado</li>
            <li>Limitação: Falácia do jogador</li>
          </ul>
          <a href={`${base}metodologia#e2`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">E3</span>
            <h3>Filtros de Equilíbrio</h3>
          </header>
          <p class="method-description">Aplica filtros: par/ímpar, soma das dezenas, faixas numéricas, desvio padrão. Organiza o lote.</p>
          <ul class="method-details">
            <li>Uso: Jogos balanceados</li>
            <li>Viés: Distribuição histórica</li>
            <li>Taxa aceitação: Variável</li>
            <li>Benefício real: Evita dias 1–31 (calendário) → reduz chance de dividir prêmio</li>
          </ul>
          <a href={`${base}metodologia#e3`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">E4</span>
            <h3>Diversificar Lote</h3>
          </header>
          <p class="method-description">Maximiza a diferença entre jogos do mesmo lote (distância de Hamming). Evita jogos iguais.</p>
          <ul class="method-details">
            <li>Uso: Bolões, múltiplos jogos</li>
            <li>Viés: Diversidade combinatória</li>
            <li>Limite: Espaço amostral</li>
          </ul>
          <a href={`${base}metodologia#e4`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="method-card card">
          <header class="method-header">
            <span class="method-badge">★</span>
            <h3>Combinado (E1+E3+E4)</h3>
          </header>
          <p class="method-description">Combina frequência + equilíbrio + diversificação. Recomendado para quem quer organização máxima.</p>
          <ul class="method-details">
            <li>Uso: Configuração completa</li>
            <li>Viés: Múltiplos descritivos</li>
            <li>Melhor para: Bolões sérios</li>
          </ul>
          <a href={`${base}metodologia#combinado`} class="method-link">Ver fórmula e exemplos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>
      </div>
  </section>

  <Disclaimer />

    </div>
  </section>

  <!-- DADOS -->
  <section class="section" aria-labelledby="lead-title" style="background: var(--color-bg);">
    <div class="container" style="text-align: center;">
      <h2 id="lead-title">Dados históricos disponíveis</h2>
      <p>Os concursos estão disponíveis em JSON e CSV na página de dados, com origem e data de atualização.</p>
      <div style="margin-top: var(--space-6);">
        <a href={`${base}dados`} class="btn btn-primary btn-lg">Ver dados</a>
      </div>
    </div>
  </section>

  <!-- CONTRIBUTION -->
  <section class="section contribution" id="contribuicao" aria-labelledby="contribuicao-title">
    <div class="container">
      <header class="section-header">
        <h2 id="contribuicao-title">Contribua com o projeto</h2>
        <p>O Jogo na Hora é independente, gratuito e de código aberto. Se o projeto for útil para você, considere apoiar a manutenção e a atualização dos dados.</p>
      </header>

      <div class="pix-box">
        <span class="pix-label">Chave PIX (voluntária)</span>
        <input type="text" class="pix-key" value="72af7962-0cf1-4f88-8d0f-1c4a58bcde4b" readonly id="pix-key" />
        <button id="btn-copiar-pix" type="button" class="btn btn-secondary btn-sm">Copiar</button>
      </div>
      <p class="text-muted" style="text-align: center; margin-top: var(--space-4); max-width: 600px; margin-left: auto; margin-right: auto;">
        <strong>A contribuição é 100% voluntária e não oferece nenhuma vantagem, benefício ou recurso extra no site.</strong> 
        O site continuará gratuito, sem cadastro e sem tracking independentemente de doações.
        <br><br>
        Nenhuma aposta é processada por este site. <a href="https://github.com/ivanmamedio/Projeto-Loteria" target="_blank" rel="noopener noreferrer">Código aberto no GitHub</a>.
      </p>
    </div>
  </section>

  <script>
    import { sampleNoReplace } from '../domain/sampling';
    import { modalidadePorId, dezenasDoUniverso, type ModalidadeId, MODALIDADES_VALIDAS } from '../domain/rules';
    import { mulberry32, newSeed } from '../domain/rng';
    import { loadData } from '../ui/load-data';
    import { addHistory, clearHistory, loadHistory } from '../ui/history';
    import { pad2 } from '../ui/format';
    import { carregarStatsHero, formatarDataBR } from '../ui/stats-hero';
    import { getClientBaseUrl } from '../utils/base-url';

    type GameResult = {
      dezenas: number[];
      meta: { janela: number; taxaAceitacao: number };
    };

    type GameMeta = {
      algorithmVersion: string;
      seed: number;
      janela: number;
      taxaAceitacao: number;
      estrategiasAtivas: string[];
      tamanhoAposta: number;
      dezenasMarcadas: number;
      universo: number;
      tentativas: number;
      jogosGerados: number;
      cacheHits: number;
      cacheSize: number;
      fallbackDepth: number;
      calibracao?: {
        brierScore: number;
        ece: number;
        interpretacao: string;
        bins: number;
        amostras: number;
      };
      janelaOtima?: number;
    };

    // Web Worker para geração
    const worker = new Worker(new URL('../workers/generate.worker.ts', import.meta.url), { type: 'module' });
    let workerResolve: ((value: { games: GameResult[]; meta: GameMeta }) => void) | null = null;
    let workerReject: ((reason: Error) => void) | null = null;

    worker.onmessage = (e: MessageEvent) => {
      const data = e.data;
      if (data.type === 'progress' && currentProgressCallback) {
        currentProgressCallback(data.progress);
      } else if (data.type === 'result' && workerResolve) {
        workerResolve({ games: data.games, meta: data.meta });
        workerResolve = null;
        workerReject = null;
      } else if (data.type === 'error' && workerReject) {
        workerReject(new Error(data.message));
        workerResolve = null;
        workerReject = null;
      }
    };

    worker.onerror = (err) => {
      if (workerReject) {
        workerReject(new Error(`Worker error: ${err.message || 'Unknown worker error'}`));
        workerResolve = null;
        workerReject = null;
      }
    };

    let currentProgressCallback: ((progress: ProgressData) => void) | null = null;

    function generateWithWorker(
      payload: WorkerPayload,
      onProgress?: (progress: ProgressData) => void
    ): Promise<{ games: GameResult[]; meta: GameMeta }> {
      return new Promise((resolve, reject) => {
        workerResolve = resolve;
        workerReject = reject;
        currentProgressCallback = onProgress || null;
        worker.postMessage({ type: 'generate', payload });
      });
    }

    type ProgressData = {
      phase: 'weights' | 'candidates' | 'diversifying' | 'fallback' | 'complete';
      progress: number;
      message: string;
      stats?: { tentativas: number; aceitos: number; jogosGerados: number };
    };

    type WorkerPayload = {
      modalidade: ModalidadeId;
      dezenasMarcadas: number[];
      opcoes: Record<string, unknown>;
      quantidade: number;
      concursos?: number[][];
      seed: number;
    };

    // Elementos do hero
    const heroResult = document.getElementById('hero-result') as HTMLElement;
    const btnSorteioHero = document.getElementById('btn-sorteio-hero') as HTMLButtonElement;
    const modalityBtns = document.querySelectorAll('.modality-picker .modality-card') as NodeListOf<HTMLButtonElement>;

    // Elementos do gerador principal
    const selectMod = document.getElementById('modalidade') as HTMLSelectElement;
    const params = new URLSearchParams(window.location.search);
    const inicial = params.get('modalidade');
    if (inicial && (MODALIDADES_VALIDAS as readonly string[]).includes(inicial)) {
      selectMod.value = inicial;
    }

    const qInput = document.getElementById('quantidade') as HTMLInputElement;
    const estrategia = document.getElementById('estrategia') as HTMLSelectElement;
    const filtros = document.getElementById('filtros') as HTMLInputElement;
    const diversificar = document.getElementById('diversificar') as HTMLInputElement;
    const evitaCal = document.getElementById('evitaCal') as HTMLInputElement;
    const janela = document.getElementById('janela') as HTMLInputElement;
    const autoSelecionar = document.getElementById('autoSelecionar') as HTMLInputElement;
    const btn = document.getElementById('btn-gerar') as HTMLButtonElement;
    const out = document.getElementById('resultado') as HTMLElement;
    const meta = document.getElementById('meta') as HTMLElement;
    const grade = document.getElementById('grade-dezenas') as HTMLElement;
    const selecaoInfo = document.getElementById('selecao-info') as HTMLElement;
    const btnLimparGrade = document.getElementById('btn-limpar-grade') as HTMLButtonElement;
    const btnSelecionarTodos = document.getElementById('btn-selecionar-todos') as HTMLButtonElement;
    const historicoLista = document.getElementById('historico-lista') as HTMLElement;
    const historicoVazio = document.getElementById('historico-vazio') as HTMLElement;
    const btnLimparHistorico = document.getElementById('btn-limpar-historico') as HTMLButtonElement;
    const btnCompartilharSelecao = document.getElementById('btn-compartilhar-selecao') as HTMLButtonElement | null;
    const btnCopiarPix = document.getElementById('btn-copiar-pix') as HTMLButtonElement | null;

    const selecionadas = new Set<number>();
    let ultimosJogos: number[][] = [];
    let modalidadeAtual = selectMod.value;

    // --- Modalidade Picker (Hero) ---
    function setModalidadeHero(mod: string): void {
      modalidadeAtual = mod;
      selectMod.value = mod;
      
      // Atualizar botões do hero
      modalityBtns.forEach(b => {
        const isActive = b.dataset.modalidade === mod;
        b.setAttribute('aria-pressed', String(isActive));
        if (isActive) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });
      
      // Re-renderizar grade
      renderizarGrade();
      atualizarBotao();
    }

    modalityBtns.forEach(b => {
      b.addEventListener('click', () => {
        const mod = b.dataset.modalidade;
        if (mod) setModalidadeHero(mod);
      });
    });

    // Sincronizar select do gerador com hero
    selectMod.addEventListener('change', () => {
      setModalidadeHero(selectMod.value);
    });

    function atualizarSelecaoInfo(): void {
      selecaoInfo.textContent = `${selecionadas.size} dezena(s) selecionada(s)`;
    }

    function renderizarGrade(): void {
      const mod = selectMod.value;
      const dezenas = dezenasDoUniverso(mod as ModalidadeId);
      grade.innerHTML = '';
      selecionadas.clear();

      const isLotomania = mod === 'lotomania';

      for (const d of dezenas) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = `number-btn${isLotomania ? ' number-btn--lotomania' : ''}`;
        b.textContent = pad2(d);
        b.dataset.value = String(d);
        b.setAttribute('aria-label', `Dezena ${pad2(d)}`);
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          if (selecionadas.has(d)) {
            selecionadas.delete(d);
            b.classList.remove('selected');
            b.setAttribute('aria-pressed', 'false');
          } else {
            selecionadas.add(d);
            b.classList.add('selected');
            b.setAttribute('aria-pressed', 'true');
          }
          atualizarSelecaoInfo();
        });
        grade.appendChild(b);
      }
      atualizarSelecaoInfo();
    }

    function atualizarBotao(): void {
      const q = Math.max(1, Math.min(10, Number(qInput.value) || 3));
      btn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
        Gerar ${q} jogo${q > 1 ? 's' : ''}
      `;
    }

    async function concursosDaModalidade(mod: string): Promise<number[][]> {
      const basePath = getClientBaseUrl();
      const res = await loadData<{ concursos: { dezenas: number[] }[] }>(`${basePath}/data/${mod}.json`);
      if (!res.ok || !res.data) return [];
      return (res.data.concursos || []).map((c) => c.dezenas);
    }

    function renderizarHistorico(): void {
      const entries = loadHistory();
      historicoLista.innerHTML = '';
      if (entries.length === 0) {
        historicoVazio.style.display = '';
        return;
      }
      historicoVazio.style.display = 'none';
      for (const e of entries) {
        const li = document.createElement('li');
        li.className = 'history-item';
        const nums = document.createElement('span');
        nums.className = 'history-numbers';
        nums.textContent = e.dezenas.map((d) => pad2(d)).join(' ');
        const metaSpan = document.createElement('span');
        metaSpan.className = 'history-meta';
        metaSpan.textContent = `${e.modalidade} · ${new Date(e.timestamp).toLocaleString('pt-BR')}`;
        li.appendChild(nums);
        li.appendChild(metaSpan);
        historicoLista.appendChild(li);
      }
    }

    function copiarTexto(texto: string): void {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(texto).catch(() => {});
      }
    }

    function baixarBlob(blob: Blob, nome: string): void {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = nome;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // ============================================================
    // GERAÇÃO DE IMAGENS (CLIENT-ONLY - canvas não existe no SSR)
    // ============================================================
    // Nota: estas funções são chamadas apenas via clique do usuário,
    // que só acontece no cliente, portanto canvas está disponível.
    // ============================================================

    // === CORES DO DESIGN SYSTEM (matching tokens.css) ===
    const CORES = {
      primary: '#0d9488',        // teal-600
      primaryHover: '#0f766e',   // teal-700
      primaryLight: '#14b8a6',   // teal-500
      primaryPale: '#ccfbf1',    // teal-50
      accent: '#d4a843',         // amber-600
      accentHover: '#b8943a',    // amber-700
      accentPale: '#fef3c7',     // amber-50
      neutral950: '#1c1917',     // stone-950
      neutral900: '#292524',     // stone-900
      neutral700: '#686058',     // stone-700
      neutral600: '#78716c',     // stone-600
      neutral500: '#a8a29e',     // stone-500
      neutral300: '#e7e5e4',     // stone-300
      neutral200: '#f5f5f4',     // stone-200
      neutral100: '#fafaf9',     // stone-100
      neutral50: '#fafaf9',      // stone-50
      success: '#166534',        // green-800
      successBg: '#dcfce7',      // green-50
      white: '#ffffff',
    };

    // Cores por modalidade
    const MODALIDADE_CORES: Record<string, { bg: string; text: string; badge: string }> = {
      'mega-sena': { bg: '#dcfce7', text: '#15803d', badge: '#166534' },      // green
      'lotofacil': { bg: '#ffedd5', text: '#ea580c', badge: '#c2410c' },      // orange
      'quina': { bg: '#dbeafe', text: '#2563eb', badge: '#1d4ed8' },           // blue
      'lotomania': { bg: '#f3e8ff', text: '#9333ea', badge: '#7e22ce' },       // purple
    };

    function desenharGradienteVertical(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, corInicio: string, corFim: string) {
      const grad = ctx.createLinearGradient(x, y, x, y + h);
      grad.addColorStop(0, corInicio);
      grad.addColorStop(1, corFim);
      ctx.fillStyle = grad;
      ctx.fillRect(x, y, w, h);
    }

    function desenharGradienteHorizontal(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, corInicio: string, corFim: string) {
      const grad = ctx.createLinearGradient(x, y, x + w, y);
      grad.addColorStop(0, corInicio);
      grad.addColorStop(1, corFim);
      ctx.fillStyle = grad;
      ctx.fillRect(x, y, w, h);
    }

    function arredondarRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }

    function desenharBolaBonita(ctx: CanvasRenderingContext2D, cx: number, cy: number, raio: number, numero: string, corFundo: string, corTexto: string) {
      // Sombra suave
      ctx.shadowColor = 'rgba(28, 25, 23, 0.15)';
      ctx.shadowBlur = 8;
      ctx.shadowOffsetY = 3;

      // Gradiente da bola
      const grad = ctx.createRadialGradient(cx - raio * 0.3, cy - raio * 0.3, 0, cx, cy, raio);
      grad.addColorStop(0, corFundo);
      grad.addColorStop(0.5, corFundo);
      grad.addColorStop(1, corFundo === CORES.primary ? CORES.primaryHover : corFundo);

      ctx.beginPath();
      ctx.arc(cx, cy, raio, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      // Borda sutil
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Reset shadow
      ctx.shadowColor = 'transparent';
      ctx.shadowBlur = 0;
      ctx.shadowOffsetY = 0;

      // Número
      ctx.fillStyle = corTexto;
      ctx.font = 'bold 22px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(numero, cx, cy + 1);
    }

    function getModalidadeNome(mod: string): string {
      const nomes: Record<string, string> = {
        'mega-sena': 'Mega-Sena',
        'lotofacil': 'Lotofácil',
        'quina': 'Quina',
        'lotomania': 'Lotomania',
      };
      return nomes[mod] ?? mod;
    }

    async function gerarImagemJogo(dezenas: number[], modalidade: string): Promise<Blob | null> {
      const canvas = document.createElement('canvas');
      canvas.width = 1080;  // Maior resolução para melhor qualidade
      canvas.height = 540;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      const modCores = MODALIDADE_CORES[modalidade] || MODALIDADE_CORES['mega-sena'];
      const modNome = getModalidadeNome(modalidade);

      // ========== BACKGROUND COM GRADIENTE E DECORAÇÕES ==========
      // Fundo gradiente suave (top-left para bottom-right)
      const bgGrad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
      bgGrad.addColorStop(0, CORES.neutral50);
      bgGrad.addColorStop(0.5, CORES.primaryPale);
      bgGrad.addColorStop(1, CORES.accentPale);
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Blob decorativo topo-esquerdo (sutil)
      ctx.save();
      ctx.globalAlpha = 0.08;
      const blobGrad1 = ctx.createRadialGradient(100, 100, 0, 100, 100, 300);
      blobGrad1.addColorStop(0, CORES.primary);
      blobGrad1.addColorStop(1, 'transparent');
      ctx.fillStyle = blobGrad1;
      ctx.beginPath();
      ctx.arc(100, 100, 300, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Blob decorativo bottom-right
      ctx.save();
      ctx.globalAlpha = 0.06;
      const blobGrad2 = ctx.createRadialGradient(canvas.width - 150, canvas.height - 150, 0, canvas.width - 150, canvas.height - 150, 350);
      blobGrad2.addColorStop(0, CORES.accent);
      blobGrad2.addColorStop(1, 'transparent');
      ctx.fillStyle = blobGrad2;
      ctx.beginPath();
      ctx.arc(canvas.width - 150, canvas.height - 150, 350, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Linha decorativa topo (brand)
      desenharGradienteHorizontal(ctx, 0, 0, canvas.width, 4, CORES.primary, CORES.accent);

      // ========== HEADER COM LOGO E MODALIDADE ==========
      const headerY = 60;

      // Logo "Jogo na Hora"
      ctx.fillStyle = CORES.neutral900;
      ctx.font = '800 42px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('Jogo na Hora', 60, headerY);

      // Badge da modalidade
      const badgeX = 60;
      const badgeY = headerY + 18;
      const badgePaddingX = 16;
      const badgePaddingY = 6;
      const badgeText = modNome.toUpperCase();
      ctx.font = '700 13px "Plus Jakarta Sans", system-ui, sans-serif';
      const badgeTextWidth = ctx.measureText(badgeText).width;
      const badgeWidth = badgeTextWidth + badgePaddingX * 2;
      const badgeHeight = 28;

      // Fundo do badge com gradiente
      arredondarRect(ctx, badgeX, badgeY, badgeWidth, badgeHeight, badgeHeight / 2);
      const badgeGrad = ctx.createLinearGradient(badgeX, badgeY, badgeX, badgeY + badgeHeight);
      badgeGrad.addColorStop(0, modCores.badge);
      badgeGrad.addColorStop(1, modCores.text);
      ctx.fillStyle = badgeGrad;
      ctx.fill();

      // Texto do badge
      ctx.fillStyle = CORES.white;
      ctx.font = '700 13px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(badgeText, badgeX + badgeWidth / 2, badgeY + badgeHeight / 2 + 1);

      // ========== ÁREA DAS DEZENAS (CENTRO) ==========
      const balls = dezenas.map((d) => d.toString().padStart(2, '0'));
      const ballRadius = 38;
      const ballGap = 20;
      const totalWidth = balls.length * (ballRadius * 2) + (balls.length - 1) * ballGap;
      const startX = (canvas.width - totalWidth) / 2;
      const centerY = canvas.height / 2 - 20;

      // Label "Suas dezenas"
      ctx.fillStyle = CORES.neutral600;
      ctx.font = '500 16px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('Suas dezenas', canvas.width / 2, centerY - 60);

      // Desenhar bolas
      balls.forEach((ball, i) => {
        const cx = startX + ballRadius + i * (ballRadius * 2 + ballGap);
        desenharBolaBonita(ctx, cx, centerY, ballRadius, ball, CORES.primary, CORES.white);
      });

      // ========== FOOTER COM AVISOS ==========
      const footerY = canvas.height - 80;

      // Linha separadora sutil
      ctx.strokeStyle = CORES.neutral300;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(60, footerY - 30);
      ctx.lineTo(canvas.width - 60, footerY - 30);
      ctx.stroke();

      // Card de aviso
      const cardY = footerY;
      const cardHeight = 60;
      const cardX = 60;
      const cardW = canvas.width - 120;

      // Fundo do card
      arredondarRect(ctx, cardX, cardY, cardW, cardHeight, 12);
      ctx.fillStyle = CORES.white;
      ctx.fill();
      ctx.strokeStyle = CORES.neutral200;
      ctx.lineWidth = 1;
      ctx.stroke();

      // Ícone de alerta (triângulo com exclamação)
      const iconX = cardX + 24;
      const iconY = cardY + cardHeight / 2;
      ctx.fillStyle = CORES.accent;
      ctx.beginPath();
      ctx.moveTo(iconX, iconY - 10);
      ctx.lineTo(iconX - 10, iconY + 10);
      ctx.lineTo(iconX + 10, iconY + 10);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = CORES.neutral950;
      ctx.font = 'bold 14px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('!', iconX, iconY + 8);

      // Textos do aviso
      ctx.fillStyle = CORES.neutral700;
      ctx.font = '500 14px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText('Toda combinação tem a mesma probabilidade de sorteio.', iconX + 28, cardY + 18);
      ctx.fillStyle = CORES.neutral600;
      ctx.font = '400 13px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.fillText('Site independente. Resultados válidos são os divulgados pela CAIXA.', iconX + 28, cardY + 42);

      // Brand bottom
      ctx.fillStyle = CORES.neutral500;
      ctx.font = '500 12px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('jogopronto.com.br  ·  Estudo e diversão  ·  18+', canvas.width / 2, canvas.height - 20);

      return await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.95));
    }

    async function gerarImagemJogos(jogos: number[][], modalidade: string): Promise<Blob | null> {
      const canvas = document.createElement('canvas');
      canvas.width = 1080;
      const paddingTop = 140;
      const paddingBottom = 120;
      const rowHeight = 72;
      const gapBetweenRows = 16;
      canvas.height = paddingTop + jogos.length * (rowHeight + gapBetweenRows) + paddingBottom;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      const modCores = MODALIDADE_CORES[modalidade] || MODALIDADE_CORES['mega-sena'];
      const modNome = getModalidadeNome(modalidade);

      // ========== BACKGROUND ==========
      const bgGrad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
      bgGrad.addColorStop(0, CORES.neutral50);
      bgGrad.addColorStop(0.4, CORES.primaryPale);
      bgGrad.addColorStop(1, CORES.accentPale);
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Blobs decorativos
      ctx.save();
      ctx.globalAlpha = 0.08;
      const blobGrad1 = ctx.createRadialGradient(100, 100, 0, 100, 100, 300);
      blobGrad1.addColorStop(0, CORES.primary);
      blobGrad1.addColorStop(1, 'transparent');
      ctx.fillStyle = blobGrad1;
      ctx.beginPath();
      ctx.arc(100, 100, 300, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      ctx.save();
      ctx.globalAlpha = 0.06;
      const blobGrad2 = ctx.createRadialGradient(canvas.width - 150, canvas.height - 150, 0, canvas.width - 150, canvas.height - 150, 350);
      blobGrad2.addColorStop(0, CORES.accent);
      blobGrad2.addColorStop(1, 'transparent');
      ctx.fillStyle = blobGrad2;
      ctx.beginPath();
      ctx.arc(canvas.width - 150, canvas.height - 150, 350, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      // Linha brand topo
      desenharGradienteHorizontal(ctx, 0, 0, canvas.width, 4, CORES.primary, CORES.accent);

      // ========== HEADER ==========
      const headerY = 60;
      ctx.fillStyle = CORES.neutral900;
      ctx.font = '800 42px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('Jogo na Hora', 60, headerY);

      // Badge modalidade
      const badgeX = 60;
      const badgeY = headerY + 18;
      const badgeText = modNome.toUpperCase();
      ctx.font = '700 13px "Plus Jakarta Sans", system-ui, sans-serif';
      const badgeTextWidth = ctx.measureText(badgeText).width;
      const badgeWidth = badgeTextWidth + 32;
      const badgeHeight = 28;
      arredondarRect(ctx, badgeX, badgeY, badgeWidth, badgeHeight, badgeHeight / 2);
      const badgeGrad = ctx.createLinearGradient(badgeX, badgeY, badgeX, badgeY + badgeHeight);
      badgeGrad.addColorStop(0, modCores.badge);
      badgeGrad.addColorStop(1, modCores.text);
      ctx.fillStyle = badgeGrad;
      ctx.fill();
      ctx.fillStyle = CORES.white;
      ctx.font = '700 13px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(badgeText, badgeX + badgeWidth / 2, badgeY + badgeHeight / 2 + 1);

      // Subtitle com quantidade de jogos
      ctx.fillStyle = CORES.neutral600;
      ctx.font = '500 18px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText(`${jogos.length} jogo${jogos.length > 1 ? 's' : ''} gerado${jogos.length > 1 ? 's' : ''}`, 60, headerY + 60);

      // ========== LISTA DE JOGOS ==========
      const startY = paddingTop;
      const leftMargin = 60;
      const rightMargin = 60;
      const availableWidth = canvas.width - leftMargin - rightMargin;
      const ballRadius = 26;
      const ballGap = 10;

      jogos.forEach((dezenas, jogoIndex) => {
        const rowY = startY + jogoIndex * (rowHeight + gapBetweenRows);
        const rowCenterY = rowY + rowHeight / 2;

        // Card do jogo
        const cardX = leftMargin;
        const cardY = rowY;
        const cardW = availableWidth;
        const cardH = rowHeight;

        // Fundo do card com gradiente sutil
        arredondarRect(ctx, cardX, cardY, cardW, cardH, 16);
        const cardGrad = ctx.createLinearGradient(cardX, cardY, cardX, cardY + cardH);
        cardGrad.addColorStop(0, CORES.white);
        cardGrad.addColorStop(1, CORES.neutral50);
        ctx.fillStyle = cardGrad;
        ctx.fill();

        // Borda esquerda colorida (brand da modalidade)
        ctx.fillStyle = modCores.badge;
        ctx.beginPath();
        ctx.moveTo(cardX, cardY);
        ctx.lineTo(cardX + 6, cardY);
        ctx.lineTo(cardX + 6, cardY + cardH);
        ctx.lineTo(cardX, cardY + cardH);
        ctx.closePath();
        ctx.fill();

        // Sombra suave do card
        ctx.shadowColor = 'rgba(28, 25, 23, 0.06)';
        ctx.shadowBlur = 12;
        ctx.shadowOffsetY = 4;
        ctx.shadowOffsetX = 0;

        // Redesenhar card com sombra (apenas visual, não afeta hit testing)
        arredondarRect(ctx, cardX, cardY, cardW, cardH, 16);
        ctx.fillStyle = cardGrad;
        ctx.fill();

        ctx.shadowColor = 'transparent';
        ctx.shadowBlur = 0;
        ctx.shadowOffsetY = 0;
        ctx.shadowOffsetX = 0;

        // Número do jogo (ex: "01", "02")
        const jogoNum = String(jogoIndex + 1).padStart(2, '0');
        ctx.fillStyle = CORES.neutral500;
        ctx.font = '700 14px "Plus Jakarta Sans", system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(jogoNum, cardX + 32, rowCenterY);

        // Bolas das dezenas
        const balls = dezenas.map((d) => d.toString().padStart(2, '0'));
        const totalBallsWidth = balls.length * (ballRadius * 2) + (balls.length - 1) * ballGap;
        const ballsStartX = cardX + 80 + (availableWidth - 80 - 40 - totalBallsWidth) / 2;

        balls.forEach((ball, i) => {
          const cx = ballsStartX + ballRadius + i * (ballRadius * 2 + ballGap);
          desenharBolaBonita(ctx, cx, rowCenterY, ballRadius, ball, CORES.primary, CORES.white);
        });

        // Label "Jogo" à direita
        ctx.fillStyle = CORES.neutral500;
        ctx.font = '500 13px "Plus Jakarta Sans", system-ui, sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        ctx.fillText('Jogo gerado', canvas.width - 60, rowCenterY);
      });

      // ========== FOOTER COM AVISOS ==========
      const footerY = canvas.height - paddingBottom + 30;

      // Linha separadora
      ctx.strokeStyle = CORES.neutral300;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(60, footerY - 20);
      ctx.lineTo(canvas.width - 60, footerY - 20);
      ctx.stroke();

      // Card de aviso
      const cardY = footerY;
      const cardHeight = 70;
      const cardX = 60;
      const cardW = canvas.width - 120;

      arredondarRect(ctx, cardX, cardY, cardW, cardHeight, 12);
      ctx.fillStyle = CORES.white;
      ctx.fill();
      ctx.strokeStyle = CORES.neutral200;
      ctx.lineWidth = 1;
      ctx.stroke();

      // Ícone de alerta
      const iconX = cardX + 24;
      const iconY = cardY + cardHeight / 2;
      ctx.fillStyle = CORES.accent;
      ctx.beginPath();
      ctx.moveTo(iconX, iconY - 12);
      ctx.lineTo(iconX - 12, iconY + 12);
      ctx.lineTo(iconX + 12, iconY + 12);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = CORES.neutral950;
      ctx.font = 'bold 16px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('!', iconX, iconY + 9);

      // Textos
      ctx.fillStyle = CORES.neutral700;
      ctx.font = '500 15px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText('Toda combinação tem a mesma probabilidade de sorteio.', iconX + 32, cardY + 20);
      ctx.fillStyle = CORES.neutral600;
      ctx.font = '400 14px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.fillText('Site independente. Resultados válidos são os divulgados pela CAIXA.', iconX + 32, cardY + 48);

      // Brand bottom
      ctx.fillStyle = CORES.neutral500;
      ctx.font = '500 12px "Plus Jakarta Sans", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';
      ctx.fillText('jogopronto.com.br  ·  Estudo e diversão  ·  18+', canvas.width / 2, canvas.height - 20);

      return await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.95));
    }

    function criarGameCard(texto: string, modalidade: string, isHero: boolean = false, indice?: number): HTMLElement {
      const card = document.createElement('div');
      card.className = 'game-card' + (isHero ? ' hero-game-card' : '');

      const gameHeader = document.createElement('div');
      gameHeader.className = 'game-header';

      const gameTitle = document.createElement('span');
      gameTitle.className = 'game-title';
      const numLabel = indice !== undefined ? ` ${String(indice).padStart(2, '0')}` : '';
      gameTitle.textContent = `${modalidade.charAt(0).toUpperCase() + modalidade.slice(1)}${numLabel}`;

      const gameBadge = document.createElement('span');
      gameBadge.className = 'game-badge';
      const badgeSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      badgeSvg.setAttribute('width', '12');
      badgeSvg.setAttribute('height', '12');
      badgeSvg.setAttribute('viewBox', '0 0 24 24');
      badgeSvg.setAttribute('fill', 'none');
      badgeSvg.setAttribute('stroke', 'currentColor');
      badgeSvg.setAttribute('stroke-width', '2');
      badgeSvg.setAttribute('aria-hidden', 'true');
      const badgePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      badgePath.setAttribute('d', 'M12 2L2 7l10 5 10-5-10-5z');
      badgeSvg.appendChild(badgePath);
      gameBadge.appendChild(badgeSvg);
      gameBadge.appendChild(document.createTextNode(' Jogo gerado'));

      gameHeader.appendChild(gameTitle);
      gameHeader.appendChild(gameBadge);

      const gameNumbers = document.createElement('div');
      gameNumbers.className = 'game-numbers';
      for (const n of texto.split(' - ')) {
        const ball = document.createElement('span');
        ball.className = 'result-ball';
        ball.textContent = n;
        gameNumbers.appendChild(ball);
      }

      const gameActions = document.createElement('div');
      gameActions.className = 'game-actions';
      const actions = [
        { action: 'copy', label: 'Copiar' },
        { action: 'download', label: 'Baixar imagem' },
        { action: 'share', label: 'WhatsApp' },
        { action: 'txt', label: 'Arquivo .txt' },
      ];
      for (const a of actions) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-secondary btn-sm';
        btn.dataset.action = a.action;
        btn.textContent = a.label;
        gameActions.appendChild(btn);
      }

      card.appendChild(gameHeader);
      card.appendChild(gameNumbers);
      card.appendChild(gameActions);
      return card;
    }

    async function executarSorteio(quantidade: number, targetContainer: HTMLElement, isHero: boolean = false): Promise<void> {
      const modalidade = modalidadeAtual;
      const m = modalidadePorId(modalidade as ModalidadeId);
      const dezenas = dezenasDoUniverso(modalidade as ModalidadeId);

      // RNG para seleção automática de dezenas
      const rng = mulberry32(newSeed());

      let marcadas: number[] = Array.from(selecionadas);
      if (autoSelecionar.checked || marcadas.length < m.minDezenas) {
        const faltam = Math.max(m.minDezenas, m.dezenasSorteadas + 6) - marcadas.length;
        if (faltam > 0) {
          const pool = dezenas.filter((d) => !marcadas.includes(d));
          const rngFn = () => rng.next();
          const extras = sampleNoReplace(pool.length, Math.min(pool.length, faltam), rngFn).map(
            (idx) => pool[idx] as number,
          );
          marcadas = marcadas.concat(extras);
        }
      }

      const opcoes: Record<string, unknown> = {
        janela: Math.max(1, Number(janela.value) || 100),
      };
      const est = estrategia.value;
      if (est === 'combinado') opcoes.estrategia = ['E1', 'E3', 'E4'];
      else opcoes.estrategia = est;
      if (filtros.checked) opcoes.filtros = true;
      if (diversificar.checked) opcoes.diversificar = true;
      if (evitaCal.checked) opcoes.evitaCalendario = true;

      const originalBtn = isHero ? btnSorteioHero : btn;
      const originalHTML = originalBtn?.innerHTML;
      
      // Container de progresso (sem innerHTML - seguro contra XSS)
      const progressContainer = document.createElement('div');
      progressContainer.className = 'progress-container';
      progressContainer.style.display = 'none';
      
      const progressBar = document.createElement('div');
      progressBar.className = 'progress-bar';
      progressBar.setAttribute('role', 'progressbar');
      progressBar.setAttribute('aria-valuenow', '0');
      progressBar.setAttribute('aria-valuemin', '0');
      progressBar.setAttribute('aria-valuemax', '100');
      progressBar.style.width = '0%';
      
      const progressText = document.createElement('div');
      progressText.className = 'progress-text';
      
      const progressStats = document.createElement('div');
      progressStats.className = 'progress-stats';
      
      progressContainer.append(progressBar, progressText, progressStats);
      
      if (!isHero) {
        targetContainer.parentNode?.insertBefore(progressContainer, targetContainer.nextSibling);
      } else {
        targetContainer.parentNode?.insertBefore(progressContainer, targetContainer.nextSibling);
      }
      
      if (originalBtn) {
        originalBtn.disabled = true;
        // Botão com createElement (seguro)
        const spinner = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        spinner.setAttribute('width', '20');
        spinner.setAttribute('height', '20');
        spinner.setAttribute('viewBox', '0 0 24 24');
        spinner.setAttribute('fill', 'none');
        spinner.setAttribute('stroke', 'currentColor');
        spinner.setAttribute('stroke-width', '2');
        spinner.setAttribute('aria-hidden', 'true');
        spinner.style.animation = 'spin 1s linear infinite';
        spinner.innerHTML = `
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1" stroke-linecap="round"/>
        `;
        
        const btnText = document.createTextNode(' Gerando…');
        originalBtn.innerHTML = '';
        originalBtn.append(spinner, btnText);
        originalBtn.disabled = true;
      }

      try {
        const concursos = await concursosDaModalidade(modalidade);
        if (concursos.length > 0) opcoes.concursos = concursos;
        
        // Mostra progresso
        progressContainer.style.display = 'block';
        const progressBar = progressContainer.querySelector('.progress-bar') as HTMLElement;
        const progressText = progressContainer.querySelector('.progress-text') as HTMLElement;
        const progressStats = progressContainer.querySelector('.progress-stats') as HTMLElement;
        
        const seed = newSeed();
        console.log('[Index] Enviando para worker:', { modalidade: modalidade as ModalidadeId, dezenasMarcadas: marcadas.length, opcoes, quantidade, seed });
        const resultado = await generateWithWorker(
          { modalidade: modalidade as ModalidadeId, dezenasMarcadas: marcadas, opcoes, quantidade, concursos: concursos.length > 0 ? concursos : undefined, seed },
          (progress) => {
            if (progressBar) progressBar.style.width = `${progress.progress}%`;
            if (progressBar) progressBar.setAttribute('aria-valuenow', String(progress.progress));
            if (progressText) progressText.textContent = progress.message;
            if (progressStats && progress.stats) {
              progressStats.textContent = `Tentativas: ${progress.stats.tentativas} · Aceitos: ${progress.stats.aceitos} · Jogos: ${progress.stats.jogosGerados}`;
            }
          }
        );
        console.log('[Worker] Resultado recebido:', { jogosGerados: resultado.games.length });
        
        // Esconde progresso
        progressContainer.style.display = 'none';
        
        const lista = Array.isArray(resultado.games) ? resultado.games : [resultado as unknown as GameResult];
        
        // Se não gerou nenhum jogo, mostrar mensagem de erro ao usuário
        if (lista.length === 0) {
          targetContainer.innerHTML = '';
          const alertDiv = document.createElement('div');
          alertDiv.className = 'alert alert-error';
          alertDiv.setAttribute('role', 'alert');
          const content = document.createElement('div');
          content.className = 'alert-content';
          const p = document.createElement('p');
          p.className = 'alert-message';
          p.textContent = 'Não foi possível gerar jogos com as configurações selecionadas. Tente desativar filtros ou escolher outra estratégia.';
          content.appendChild(p);
          alertDiv.appendChild(content);
          targetContainer.appendChild(alertDiv);
          meta.textContent = '';
          return;
        }

        targetContainer.innerHTML = '';
        ultimosJogos = lista.map((g: GameResult) => g.dezenas);

        for (let gi = 0; gi < lista.length; gi++) {
           const g = lista[gi] as GameResult;
          const texto = g.dezenas.map((d: number) => pad2(d)).join(' - ');
          const card = criarGameCard(texto, modalidade, isHero, gi + 1);
          targetContainer.appendChild(card);

          // Bind actions
          card.querySelector('[data-action="copy"]')?.addEventListener('click', () => copiarTexto(texto));
          card.querySelector('[data-action="download"]')?.addEventListener('click', async () => {
            const blob = await gerarImagemJogos(ultimosJogos, modalidade);
            if (blob) baixarBlob(blob, `jogo-na-hora-${modalidade}-${Date.now()}.jpg`);
          });
          card.querySelector('[data-action="share"]')?.addEventListener('click', async () => {
            const textoCompartilhamento = `Jogo na Hora — ${modalidade}:\n${ultimosJogos.map(j => j.map(d => pad2(d)).join(' - ')).join('\n')}`;
            const blob = await gerarImagemJogos(ultimosJogos, modalidade);
            if (blob && navigator.share && navigator.canShare) {
              const arquivo = new File([blob], 'jogo-na-hora.jpg', { type: 'image/jpeg' });
              if (navigator.canShare({ files: [arquivo] })) {
                try {
                  await navigator.share({ title: 'Jogo na Hora', text: textoCompartilhamento, files: [arquivo] });
                  return;
                } catch {
                  // fallback
                }
              }
            }
            window.open(`https://wa.me/?text=${encodeURIComponent(textoCompartilhamento)}`, '_blank', 'noopener,noreferrer');
          });
          card.querySelector('[data-action="txt"]')?.addEventListener('click', () => {
            const conteudo = `Jogo na Hora\nModalidade: ${modalidade}\nDezenas:\n${ultimosJogos.map(j => j.map(d => pad2(d)).join(' - ')).join('\n')}\n\nAviso: toda combinação tem a mesma probabilidade de sorteio.`;
            const blob = new Blob([conteudo], { type: 'text/plain;charset=utf-8' });
            baixarBlob(blob, `jogo-na-hora-${modalidade}-${Date.now()}.txt`);
          });
        }

        if (!isHero) {
          meta.textContent = `Janela: ${resultado.meta.janela} concursos · Taxa de aceitação: ${(resultado.meta.taxaAceitacao * 100).toFixed(1)}%`;

          const timestamp = new Date().toISOString();
          for (const g of lista) {
            addHistory({
              id: `${modalidade}-${timestamp}-${g.dezenas.join(',')}`,
              modalidade,
              dezenas: g.dezenas,
              timestamp,
            });
          }
          renderizarHistorico();

          // Scroll para resultado
          out.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch (err) {
        // Esconde progresso em caso de erro
        progressContainer.style.display = 'none';
        
        const alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-error';
        alertDiv.setAttribute('role', 'alert');
        const content = document.createElement('div');
        content.className = 'alert-content';
        const p = document.createElement('p');
        p.className = 'alert-message';
        p.textContent = (err as Error).message;
        content.appendChild(p);
        alertDiv.appendChild(content);
        targetContainer.replaceChildren(alertDiv);
        if (!isHero) meta.textContent = '';

      } finally {
        // Limpa container de progresso
        progressContainer.remove();
        
        if (originalBtn) {
          originalBtn.disabled = false;
          originalBtn.innerHTML = originalHTML || '';
          if (!isHero) atualizarBotao();
        }
      }
    }

    btnLimparGrade.addEventListener('click', () => {
      selecionadas.clear();
      grade.querySelectorAll('.number-btn').forEach((el) => {
        el.classList.remove('selected');
        el.setAttribute('aria-pressed', 'false');
      });
      atualizarSelecaoInfo();
    });

    btnSelecionarTodos.addEventListener('click', () => {
      dezenasDoUniverso(selectMod.value as ModalidadeId).forEach((d) => selecionadas.add(d));
      grade.querySelectorAll('.number-btn').forEach((el) => {
        el.classList.add('selected');
        el.setAttribute('aria-pressed', 'true');
      });
      atualizarSelecaoInfo();
    });

    btnCompartilharSelecao?.addEventListener('click', () => {
      const nums = Array.from(selecionadas)
        .sort((a, b) => a - b)
        .map((d) => pad2(d))
        .join(' - ');
      const texto = `Jogo na Hora — ${selectMod.value}: ${nums || 'nenhuma dezena selecionada'}`;
      window.open(`https://wa.me/?text=${encodeURIComponent(texto)}`, '_blank', 'noopener,noreferrer');
    });

    btnLimparHistorico.addEventListener('click', () => {
      clearHistory();
      renderizarHistorico();
    });

    qInput.addEventListener('input', atualizarBotao);

    const outAvancado = document.getElementById('resultado-avancado') as HTMLElement;
    btn.addEventListener('click', () => executarSorteio(Math.max(1, Math.min(10, Number(qInput.value) || 3)), outAvancado, false));

    // Hero: sortear 1 jogo e mostrar no hero-result
    btnSorteioHero?.addEventListener('click', () => {
      executarSorteio(1, heroResult, true);
      heroResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    btnCopiarPix?.addEventListener('click', () => {
      copiarTexto('72af7962-0cf1-4f88-8d0f-1c4a58bcde4b');
      if (btnCopiarPix) {
        btnCopiarPix.textContent = 'Copiado!';
        setTimeout(() => { if (btnCopiarPix) btnCopiarPix.textContent = 'Copiar'; }, 2000);
      }
    });

    // Lead form removido: coleta de email sem integração funcional (ver correcoes.md §6).
    // Dados disponíveis em /dados.

    // Carregar contagem de concursos para hero stats (inline)
    (async () => {
      try {
        let total = 0;
        let latestDate: Date | null = null;
        const basePath = getClientBaseUrl();
        for (const mod of MODALIDADES_VALIDAS) {
          try {
            const res = await loadData<{ concursos: { dezenas: number[]; data?: string }[] }>(`${basePath}/data/${mod}.json`);
            if (res.ok && res.data?.concursos) {
              total += res.data.concursos.length;
              for (const c of res.data.concursos) {
                if (c.data) {
                  const d = new Date(c.data);
                  if (!latestDate || d > latestDate) latestDate = d;
                }
              }
            }
          } catch {
            // Silenciosamente ignora erros
          }
        }
        const el = document.getElementById('stat-concursos');
        if (el) el.textContent = total.toLocaleString('pt-BR');
        const elDate = document.getElementById('stat-atualizado');
        if (elDate && latestDate) {
          elDate.textContent = latestDate.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }
      } catch {
        // Silenciosamente ignora erros
      }
    })();

    // Inicializar modalidade ativa baseada na URL ou padrão
    const urlModalidade = params.get('modalidade');
    if (urlModalidade && MODALIDADES_VALIDAS.includes(urlModalidade)) {
      setModalidadeHero(urlModalidade);
    } else {
      setModalidadeHero('mega-sena');
    }

    // Estilo para spinner
    const style = document.createElement('style');
    style.textContent = `@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }`;
    document.head.appendChild(style);
  </script>
