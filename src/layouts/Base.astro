---
// Layout base do site
// Referência: tasks_loteria.md — T1.1 (Astro + TS estrito)
// Estilo: CSS puro (variáveis + escopo do Astro)
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jogo na Hora — geração gratuita de combinações de loteria com probabilidade verificável" />
    <title>Jogo na Hora — gerador de combinações de loteria</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <header class="header">
      <div class="container">
        <a href="/" class="logo">Jogo na Hora</a>
        <nav>
          <ul class="nav-list">
            <li><a href="/">Início</a></li>
            <li><a href="/como-funciona">Como funciona</a></li>
            <li><a href="/estatisticas">Estatísticas</a></li>
            <li><a href="/dados">Dados</a></li>
            <li><a href="/sobre">Sobre</a></li>
            <li><a href="/privacidade">Privacidade</a></li>
            <li><a href="/termos">Termos</a></li>
            <li><a href="/#contribuicao">Contribua</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <div id="responsabilidade-modal" class="resp-modal" hidden>
      <div class="resp-card" role="dialog" aria-modal="true" aria-labelledby="resp-titulo">
        <h2 id="resp-titulo">Termo de responsabilidade</h2>
        <p>
          Este site é independente, gratuito e destinado a pessoas com 18 anos
          ou mais. As combinações são geradas por algoritmos e não garantem
          prêmio nem vantagem estatística. Confirme que leu e aceita os termos
          antes de continuar.
        </p>
        <label class="resp-check">
          <input type="checkbox" id="resp-check" />
          Li e aceito o termo de responsabilidade e os Termos de Uso.
        </label>
        <div class="resp-actions">
          <a href="/termos">Ler termos completos</a>
          <button id="resp-confirm" type="button" disabled>Aceitar e continuar</button>
        </div>
      </div>
    </div>

    <script>
      const CHAVE_RESP = 'jp-responsabilidade-aceita';
      const modal = document.getElementById('responsabilidade-modal');
      const check = document.getElementById('resp-check') as HTMLInputElement | null;
      const confirmar = document.getElementById('resp-confirm') as HTMLButtonElement | null;
      if (modal && !localStorage.getItem(CHAVE_RESP)) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        check?.addEventListener('change', () => {
          if (confirmar) confirmar.disabled = !check.checked;
        });
        confirmar?.addEventListener('click', () => {
          localStorage.setItem(CHAVE_RESP, '1');
          modal.hidden = true;
          document.body.style.overflow = '';
        });
      }
    </script>

    <script>
      // marca o link ativo do menu
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll('.nav-list a').forEach((a) => {
        const href = (a.getAttribute('href') || '').replace(/\/$/, '') || '/';
        if (href === path || (href !== '/' && path.startsWith(href))) {
          a.setAttribute('aria-current', 'page');
        }
      });
    </script>
      <div class="container">
        <p>
          &copy; 2026 — Jogo na Hora. Site independente de estudo e diversão sobre
          loterias da CAIXA. Sem vínculo, afiliação ou endosso da Caixa Econômica
          Federal. Jogo responsável. Público adulto (18+). Resultados válidos são
          sempre os divulgados pela CAIXA.
        </p>
      </div>
    </footer>
  </body>
</html>
