---
// Layout base do site — Jogo na Hora
import '../styles/global.css';
const base = `${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/`;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jogo na Hora — Gerador gratuito de combinações de loteria com estratégias baseadas em dados oficiais da Caixa. Sem promessas falsas, 100% transparente." />
    <meta name="theme-color" content="#007A33" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jogo na Hora" />
    <meta property="og:title" content="Jogo na Hora — Gerador de combinações de loteria" />
    <meta property="og:description" content="Gere jogos da Mega-Sena, Lotofácil, Quina e Lotomania com 4 estratégias baseadas em dados reais. Histórico local, exportação CSV, sem cadastro." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:url" content="https://ivanmamedio.github.io/Projeto-Loteria/" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jogo na Hora — Gerador de combinações de loteria" />
    <meta name="twitter:description" content="Gere jogos com estratégias baseadas em dados reais da Caixa. Gratuito, transparente, sem tracking." />
    <meta name="twitter:image" content="/og-image.jpg" />
    
    <!-- Preconnect para fonts (system fonts não precisam, mas mantemos para og:image) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <title>Jogo na Hora — Gerador de combinações de loteria</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo principal</a>
    
    <header class="header" role="banner">
      <div class="container">
        <a href={base} class="logo" aria-label="Jogo na Hora — Início">Jogo na Hora</a>
        
        <!-- Mobile menu toggle -->
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
        <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </label>
        
        <nav class="nav" role="navigation" aria-label="Navegação principal">
          <ul class="nav-list">
            <li><a href={base}>Início</a></li>
            <li><a href={`${base}como-funciona`}>Como funciona</a></li>
            <li><a href={`${base}estatisticas`}>Estatísticas</a></li>
            <li><a href={`${base}dados`}>Dados</a></li>
            <li><a href={`${base}sobre`}>Sobre</a></li>
            <li><a href={`${base}privacidade`}>Privacidade</a></li>
            <li><a href={`${base}termos`}>Termos</a></li>
            <li><a href={`${base}#contribuicao`}>Contribua</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo" role="main">
      <slot />
    </main>

    <!-- Modal de responsabilidade (primeiro acesso) -->
    <div id="responsabilidade-modal" class="resp-modal" hidden>
      <div class="resp-card" role="dialog" aria-modal="true" aria-labelledby="resp-titulo">
        <h2 id="resp-titulo">Termo de responsabilidade</h2>
        <p>
          Este site é independente, gratuito e destinado a pessoas com 18 anos
          ou mais. As combinações são geradas por algoritmos e não garantem
          prêmio nem vantagem estatística. Confirme que leu e aceita os termos
          antes de continuar.
        </p>
        <label class="resp-check">
          <input type="checkbox" id="resp-check" />
          Li e aceito o termo de responsabilidade e os <a href={`${base}termos`}>Termos de Uso</a>.
        </label>
        <div class="resp-actions">
          <a href={`${base}termos`} class="btn btn-ghost btn-sm">Ler termos completos</a>
          <button id="resp-confirm" type="button" class="btn btn-primary btn-sm" disabled>Aceitar e continuar</button>
        </div>
      </div>
    </div>

    <footer class="footer" role="contentinfo">
      <div class="container">
        <div class="footer-brand">
          <div class="footer-logo">Jogo na Hora</div>
          <p class="footer-tagline">
            Ferramentas transparentes para loterias da Caixa. Dados oficiais, estratégias documentadas, 
            histórico local no seu navegador. Sem promessas falsas.
          </p>
          <div class="flex gap-3" style="margin-top: var(--space-4);">
            <a href="https://github.com/ivanmamedio/Projeto-Loteria" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm" style="color: var(--color-text); border-color: var(--color-border);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
            <a href={`${base}llms.txt`} class="btn btn-ghost btn-sm" style="color: var(--color-text); border-color: var(--color-border);">llms.txt</a>
          </div>
        </div>

        <nav class="footer-links" aria-label="Produto">
          <h3 class="footer-heading">Produto</h3>
          <a href={base}>Início</a>
          <a href={`${base}como-funciona`}>Como funciona</a>
          <a href={`${base}estatisticas`}>Estatísticas</a>
          <a href={`${base}dados`}>Dados</a>
        </nav>

        <nav class="footer-links" aria-label="Recursos">
          <h3 class="footer-heading">Recursos</h3>
          <a href={`${base}sobre`}>Sobre o projeto</a>
          <a href={`${base}privacidade`}>Privacidade</a>
          <a href={`${base}termos`}>Termos de uso</a>
        </nav>

        <nav class="footer-links" aria-label="Comunidade">
          <h3 class="footer-heading">Comunidade</h3>
          <a href="https://github.com/ivanmamedio/Projeto-Loteria/issues" target="_blank" rel="noopener noreferrer">Reportar problema</a>
          <a href="https://github.com/ivanmamedio/Projeto-Loteria/discussions" target="_blank" rel="noopener noreferrer">Sugerir melhoria</a>
          <a href="#contribuicao">Contribuir (PIX)</a>
        </nav>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Jogo na Hora. Site independente de estudo e diversão sobre loterias da CAIXA. Sem vínculo, afiliação ou endosso da Caixa Econômica Federal. Jogo responsável. Público adulto (18+). Resultados válidos são sempre os divulgados pela CAIXA.</p>
          <div class="flex gap-4">
            <a href={`${base}privacidade`}>Privacidade</a>
            <a href={`${base}termos`}>Termos</a>
            <a href={`${base}llms.txt`}>llms.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Marca link ativo do menu
      const baseNoSlash = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') || '/';
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll('.nav-list a').forEach((a) => {
        const rawHref = a.getAttribute('href') || '';
        const hasHash = rawHref.includes('#');
        const hrefPath = rawHref.split('#')[0].replace(/\/$/, '') || '/';
        const hash = rawHref.split('#')[1] ? '#' + rawHref.split('#')[1] : '';
        const isActive = hasHash
          ? (window.location.hash === hash && (path === hrefPath || hrefPath === baseNoSlash))
          : hrefPath === '/'
            ? path === hrefPath || path === baseNoSlash
            : path === hrefPath || path.startsWith(hrefPath + '/');
        if (isActive) {
          a.setAttribute('aria-current', 'page');
        }
      });

      // Modal responsabilidade
      const CHAVE_RESP = 'jp-responsabilidade-aceita';
      const modal = document.getElementById('responsabilidade-modal');
      const check = document.getElementById('resp-check');
      const confirmar = document.getElementById('resp-confirm');
      if (modal && !localStorage.getItem(CHAVE_RESP)) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        check?.addEventListener('change', () => {
          if (confirmar) confirmar.disabled = !check.checked;
        });
        confirmar?.addEventListener('click', () => {
          localStorage.setItem(CHAVE_RESP, '1');
          modal.hidden = true;
          document.body.style.overflow = '';
        });
      }
    </script>
  </body>
</html>