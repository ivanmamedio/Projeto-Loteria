# Variáveis de ambiente para o Jogo na Hora
# Copie este arquivo para .env e preencha os valores reais
# NUNCA comite o arquivo .env real no repositório

# URL pública do site (obrigatório para sitemap, canonical URLs, Open Graph)
# Exemplo: SITE_URL=https://jogonahora.com.br
SITE_URL=https://example.com

# E-mail de contato para privacidade/LGPD (opcional - se não definir, usa o placeholder)
# Exemplo: PRIVACY_EMAIL=privacidade@seudominio.com.br
# PRIVACY_EMAIL=

# Ambiente de execução (development | production)
# NODE_ENV=production